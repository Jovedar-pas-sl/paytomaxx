# ============================================
# PEANPE AUTOMATION - Variables de Entorno
# ============================================

# ============================================
# SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# BASE DE DATOS (PostgreSQL)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=peanpe_automation
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# ============================================
# REDIS (Cache y Colas)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# PEANPE PAYMENTS API
# ============================================
PEANPE_API_KEY=tu_api_key_aqui
PEANPE_API_SECRET=tu_api_secret_aqui
PEANPE_API_URL=https://api.peanpe.com/v1
PEANPE_WEBHOOK_SECRET=tu_webhook_secret_aqui

# ============================================
# EVOLUTION API (WhatsApp)
# ============================================
EVOLUTION_API_URL=https://tu-instancia.evolution-api.com
EVOLUTION_API_KEY=tu_evolution_api_key_aqui
EVOLUTION_INSTANCE_NAME=tu_instancia_nombre

# ============================================
# CHATWOOT (WhatsApp/SMS)
# ============================================
CHATWOOT_API_URL=https://tu-instancia.chatwoot.com
CHATWOOT_API_TOKEN=tu_chatwoot_api_token_aqui
CHATWOOT_ACCOUNT_ID=tu_account_id_aqui
CHATWOOT_INBOX_ID=tu_inbox_id_aqui

# ============================================
# RESEND (Email)
# ============================================
RESEND_API_KEY=tu_resend_api_key_aqui
EMAIL_FROM=pagos@tudominio.com
EMAIL_FROM_NAME=Tu Empresa

# ============================================
# JWT (Autenticación)
# ============================================
JWT_SECRET=tu_jwt_secret_aqui
JWT_EXPIRES_IN=7d

# ============================================
# URLs
# ============================================
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# WEBHOOKS
# ============================================
WEBHOOK_VERIFY_TOKEN=tu_verify_token_aqui
