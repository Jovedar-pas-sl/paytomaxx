# OxioPay / NightPay — plantilla de entorno.
# Desarrollo: cópiala a .env.local (no se sube a git) y ajusta lo que haga falta.
# Producción: estas variables van en Dokploy → servicio → Environment (ver
# docs/DOKPLOY-STEPS.md); los valores de aquí NO valen para producción.
# Lista sacada de apps/api/src/config/env.ts (lo que no esté ahí, el API no lo lee).

# ── Núcleo ────────────────────────────────────────────────────────────────
# Si falta, el API arranca como PRODUCCIÓN (exige secretos, CORS, etc.).
# `pnpm dev` ya pone development; si lanzas el API de otra forma en local,
# déjalo así:
NODE_ENV=development
PORT=4100
# fatal | error | warn | info | debug | trace
LOG_LEVEL=debug

# Postgres (docker compose de desarrollo: puerto 4432 del equipo → 5432).
DATABASE_URL=postgresql://np:np@localhost:4432/nightpay?schema=public
# Redis: caché, colas BullMQ y Socket.IO (puerto 4379 del equipo → 6379).
REDIS_URL=redis://localhost:4379

# ── Secretos (en producción: generarlos, ver DOKPLOY-STEPS «Fase 0») ──────
# Mínimo 32 caracteres. Estos son solo para tu equipo.
JWT_SECRET=dev-jwt-solo-local-no-vale-en-produccion-0123456789
COOKIE_SECRET=dev-cookie-solo-local-no-vale-en-produccion-012345
# Cifra las credenciales de pasarela y firma el PIN del saldo.
ENCRYPTION_KEK=dev-kek-solo-local-no-vale-en-produccion-0123456789

# ── Producción detrás de Cloudflare ───────────────────────────────────────
# Secreto que Cloudflare añade como cabecera X-Origin-Auth (regla de
# transformación): sin ella el API rechaza lo que llegue directo a la IP del
# VPS. Obligatorio en producción (mín. 24). Ver docs/PUESTA-EN-MARCHA.md.
# ORIGIN_AUTH_SECRET=
# GET /v1/metrics desde fuera solo con «Authorization: Bearer <token>».
# Obligatorio en producción (mín. 24).
# METRICS_TOKEN=
# Orígenes permitidos (CSV): las direcciones exactas de las apps, https y sin
# barra final. Obligatoria en producción (sin ella el API no arranca).
# CORS_ORIGINS=https://admin.tudominio.com,https://operator.tudominio.com,https://pay.tudominio.com,https://tpv.tudominio.com

# ── URLs públicas ─────────────────────────────────────────────────────────
# URL pública del API: Redsys/Wipay mandan aquí sus avisos. En producción
# es obligatoria y no puede ser localhost. Para las webs Next es variable de
# BUILD (se mete al construir la imagen), no de ejecución.
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_WS_URL=ws://localhost:4100
# Webs de la chica (operator) y de pago del cliente. Las usa el API para los
# enlaces que envía (invitaciones, cobros, saldo).
NEXT_PUBLIC_OPERATOR_URL=http://localhost:4104
NEXT_PUBLIC_WEB_CLIENT_URL=http://localhost:4101
# Donde la chica acepta la invitación (si falta NEXT_PUBLIC_OPERATOR_URL).
OPERATOR_BASE_URL=http://localhost:4104
# Face ID del saldo: la llave vale en el dominio común de API y web de pago
# (api.x.com + pay.x.com → x.com). Solo hace falta con dominios de tres
# trozos (p. ej. oxiopay.com.es).
# PASSKEY_RP_ID=
# Datáfono simulado en la web del operador (solo desarrollo, variable de build).
# NEXT_PUBLIC_PAX_SIMULATOR=1

# ── Marca ─────────────────────────────────────────────────────────────────
# Nombre en pantallas, concepto del cobro y correos (por defecto OxioPay).
# BRAND_NAME=
# Nombre del cobro en el extracto del cliente (lo fija BBVA; solo se enseña).
# PAY_STATEMENT_NAME=
# Página de pago en el móvil: el botón principal abre directamente Apple Pay /
# Google Pay (pedido «xpay» de Redsys) y «Pagar con tarjeta» va aparte. Con
# false, un solo botón lleva a la página del banco (tarjeta y, si BBVA los
# tiene activos, Apple Pay / Google Pay). Ponlo a false si BBVA no tiene xpay.
# PAY_DIRECT_WALLET=true

# ── Pagar con bitcoin (BTCPay Server, opcional) ───────────────────────────
# Apagado por defecto: sin esto no hay rutas (404), ni botón «Pagar con bitcoin»,
# ni repaso de facturas. Encendido, cada local lo activa además en Ajustes →
# Formas de cobro → Bitcoin (BTCPay) con SU BTCPay (dirección https, id de tienda
# y clave de API, cifrada con ENCRYPTION_KEK). El API necesita NEXT_PUBLIC_API_URL
# (su dirección pública) para registrar el aviso en BTCPay.
# BTCPAY_ENABLED=false

# ── Google Wallet (opcional, ver docs/GOOGLE-WALLET.md) ───────────────────
# «Añadir a Google Wallet» en la página del saldo (solo Android) y el pase
# se actualiza solo. Sin emisor y clave, el botón no sale y no corre nada.
# Emisor: el "Issuer ID" de la Google Pay & Wallet Console (solo cifras).
# GOOGLE_WALLET_ISSUER_ID=
# Clave JSON de la cuenta de servicio, tal cual (entre comillas simples), o
# el mismo JSON en base64 (más fácil de pegar). Solo una de las dos.
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON=
# GOOGLE_WALLET_SERVICE_ACCOUNT_JSON_B64=
# Nombre de la clase de los pases (letras, números, . _ -).
# GOOGLE_WALLET_CLASS_SUFFIX=oxiopay_saldo

# ── Redsys (TPV de BBVA) ──────────────────────────────────────────────────
# Pruebas: https://sis-t.redsys.es:25443/sis/realizarPago
# Real:    https://sis.redsys.es/sis/realizarPago
REDSYS_API_URL=https://sis-t.redsys.es:25443/sis/realizarPago
# Código de comercio (FUC), terminal y clave de firma (base64) que da el banco.
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_SECRET_KEY=
# Forzar método en la página de Redsys ("xpay" = solo Apple/Google Pay,
# "C" = solo tarjeta). Recomendado: vacío.
# REDSYS_PAYMETHODS=
# Nombre del comercio en la página de Redsys (máx. 25). Vacío = el del contrato.
# REDSYS_MERCHANT_NAME=

# ── Paytef (Payment LINK y datáfonos PAX) ─────────────────────────────────
PAYTEF_API_URL=https://api.paytef.es/gcf
# Token de my.paytef.es (sin el prefijo "PAYTEF-TOKEN "). Vacío = desactivado.
PAYTEF_API_TOKEN=
# Secreto de la URL de avisos de Paytef (openssl rand -hex 32).
PAYTEF_WEBHOOK_SECRET=
# URL pública de avisos y de vuelta del cliente.
PAYTEF_WEBHOOK_URL=
PAYTEF_RETURN_URL=
# Comercio y sucursal en Paytef (GET /payment-link/getBranches).
# PAYTEF_COMPANY_ID=
# PAYTEF_BRANCH_ID=
# Caducidad de la credencial de un datáfono vinculado, en días. Vacío = no caduca.
# POS_DEVICE_TOKEN_MAX_AGE_DAYS=

# ── Wipay (Cecabank) — sin claves activas ─────────────────────────────────
WIPAY_API_URL=https://tpv.ceca.es/tpvweb/tpv/compra.action
WIPAY_MERCHANT_ID=
WIPAY_ACQUIRER_BIN=
WIPAY_TERMINAL_ID=
WIPAY_CLAVE_ENCRIPTACION=

# ── Peanpe — sin claves activas ───────────────────────────────────────────
# PEANPE_API_URL y PEANPE_WEBHOOK_SECRET son obligatorias aunque no se use
# (en desarrollo, el simulador de docker compose en :4902).
PEANPE_API_URL=http://localhost:4902
PEANPE_WEBHOOK_SECRET=dev-peanpe-secret
PEANPE_API_BASE_URL=http://peanpe.com
# Clave en hexadecimal e id de cuenta que da Peanpe.
PEANPE_API_KEY=
PEANPE_ACCOUNT_ID=
PEANPE_WEBHOOK_URL=
PEANPE_THANKYOU_URL=

# Tiempo máximo de una llamada a una pasarela (ms).
GATEWAY_TIMEOUT_MS=5000

# ── Avisos al dueño ───────────────────────────────────────────────────────
# Telegram: incidencias al momento y resumen de las 9:00. Sin las dos no se
# manda nada (la bandeja de Incidencias funciona igual).
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# Correo (Resend). Sin clave, el enlace de invitación se le da al admin.
# RESEND_API_KEY=
# EMAIL_FROM=OxioPay <no-responder@tudominio.com>
# Errores a Sentry (opcional).
# SENTRY_DSN=

# ── Copias de seguridad (vigilante del API, ver docs/BACKUPS.md) ──────────
# Clave de SOLO LECTURA del bucket donde Dokploy sube las copias.
# BACKUP_S3_ENDPOINT=https://<id-de-cuenta>.r2.cloudflarestorage.com
# BACKUP_S3_REGION=auto
# BACKUP_S3_BUCKET=oxiopay-copias
# BACKUP_S3_PREFIX=nightpay-postgres-xxxxx/
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# Horas sin copia nueva antes de avisar (copia cada 6 h → 8).
# BACKUP_MAX_AGE_HOURS=8

# ── Dinero de las chicas ──────────────────────────────────────────────────
# Días que una comisión queda en espera antes de poder pagarla.
PAYOUT_HOLD_DAYS=7

# ── Mapa del dinero ───────────────────────────────────────────────────────
# Comisión del banco sobre lo cobrado con tarjeta, en bps (45 = 0,45 %). Sin
# ella, el mapa del dinero no la calcula: sale en el extracto de BBVA.
# BANK_CARD_FEE_BPS=45

# ── Diagnóstico ───────────────────────────────────────────────────────────
# /v1/debug/*: estado interno (últimos cobros, avisos…). Además hace falta
# ser super-admin. En producción, solo mientras se diagnostica.
DEBUG_ENDPOINTS_ENABLED=false
# Consultas de Prisma sin local en el contexto: "log" = solo avisa en el
# log (las demás opciones, en apps/api/src/config/env.ts).
TENANCY_UNSCOPED_QUERIES=log
# Tiempo real sin sesión (apps antiguas en caché): se apaga sola el martes
# 2026-11-17 a las 12:00 (Madrid) y luego se pide «Inicia sesión otra vez».
# Para otra fecha, ISO con zona (mejor un martes o miércoles a mediodía, nunca
# en plena noche); "off" = apagada ya: ponlo en cuanto la métrica
# nightpay_ws_legacy_subscribes_total lleve días sin subir.
# REALTIME_LEGACY_SUBSCRIBE_UNTIL=2026-11-17T12:00:00+01:00
# Sesión del personal: el refresh token en el cuerpo (apps antiguas en caché)
# se acepta hasta el martes 2026-12-01 a las 12:00 (Madrid); las nuevas lo llevan en una
# cookie HttpOnly. Otra fecha, ISO con zona; "off" = cerrada ya. Antes, la
# métrica nightpay_auth_body_refresh_total{client="legacy"} debería estar
# quieta. Ver docs/SESION-PERSONAL.md.
# AUTH_BODY_REFRESH_UNTIL=2026-12-01T12:00:00+01:00
# Qué versión corre (sale en /v1/health). En la imagen Docker vienen como
# build args; aquí solo si quieres verlo en local.
# GIT_SHA=
# BUILD_MARKER=

# Solo desarrollo/pruebas: apagar tareas programadas (1 = apagada). En
# producción el API avisa al arrancar de cada una que esté a 1.
# ALERTS apaga TODOS los avisos por Telegram: incidencias, resumen de la
# mañana, los «Por aprobar» al dueño y la 2FA activada de un super-admin.
# NIGHTPAY_DISABLE_ALERTS=1
# NIGHTPAY_DISABLE_NIGHT_AUTOCLOSE=1
# NIGHTPAY_DISABLE_GOOGLE_WALLET_SYNC=1
# Repaso cada hora de los avisos de la pasarela que no se llegaron a procesar.
# NIGHTPAY_DISABLE_WEBHOOK_SWEEP=1
# Reintento del descuento a la chica de las devoluciones ya hechas.
# NIGHTPAY_DISABLE_REFUND_SWEEP=1
# Repaso cada 10 min de los cobros sin pagar pasado su plazo (QR / datáfono).
# NIGHTPAY_DISABLE_QR_EXPIRE_SWEEP=1
# «Liquidación OxioPay» del lunes (lo que cada local debe a OxioPay) y su aviso por Telegram.
# NIGHTPAY_DISABLE_OXIOPAY_SETTLEMENTS=1
# «Saldo al momento»: los avisos de Postgres (LISTEN) a las páginas del saldo
# y a la app del personal. Apagado, todo va por el sondeo de respaldo.
# NIGHTPAY_DISABLE_WALLET_EVENTS=1
# Solo si DATABASE_URL pasa por un PgBouncer en modo transacción (LISTEN no va
# por él): una URL directa a Postgres para escuchar. Sin ella, DATABASE_URL.
# WALLET_EVENTS_DATABASE_URL=

# Opcionales sin uso hoy (exploradores de blockchain y Viva SoftPOS).
# TRONSCAN_API_KEY=
# BSCSCAN_API_KEY=
# POLYGONSCAN_API_KEY=
# HELIUS_API_KEY=
# VIVA_API_KEY=
# VIVA_MERCHANT_ID=
# VIVA_WEBHOOK_SECRET=
# VIVA_BASE_URL=https://demo-api.vivapayments.com

# Solo para `pnpm db:seed` (desarrollo): contraseña de los usuarios que cree.
# Sin ella se genera una al azar. El seed no va en las imágenes Docker.
# SEED_PASSWORD=
