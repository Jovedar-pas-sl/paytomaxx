# NightPay — plantilla de entorno (copia a .env.local y edita)
# No commits de .env.local (gitignored)

# ── Core ────────────────────────────────────────────────────────────
# Puerto API: 4100 (rango 4xxx, dev limpio sin conflictos)
NODE_ENV=development
PORT=4100
LOG_LEVEL=debug

# ── Database (Docker Compose dev) ────────────────────────────────────
# Host port 4432 → container 5432 (evita conflicto con cualquier otro Postgres)
DATABASE_URL=postgresql://np:np@localhost:4432/nightpay?schema=public

# ── Redis (cache + BullMQ + Socket.io adapter) ───────────────────────
# Host port 4379 → container 6379
REDIS_URL=redis://localhost:4379

# ── Auth & crypto ────────────────────────────────────────────────────
# ROTAR en producción: usar `openssl rand -hex 32` o equivalente.
# Valores aquí: 64 chars hex (32 bytes) — válidos para desarrollo local SOLO.
JWT_SECRET=dev_jwt_a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6_v1
COOKIE_SECRET=dev_cookie_a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6_v1
# KEK (Key Encryption Key) para cifrar credenciales de pasarela en DB
# ROTAR en producción con `openssl rand -base64 32`
ENCRYPTION_KEK=dev_kek_a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6_v1

# ── Gateways (mocks en dev) ──────────────────────────────────────────
# Wipay = TPV Virtual de Cecabank (Global Payment Systems).
#   Sandbox: https://tpv.ceca.es/tpvweb/tpv/compra.action
#   Prod:    https://pgw.ceca.es/tpvweb/tpv/compra.action
# Las 4 credenciales (MerchantID, AcquirerBIN, TerminalID, Clave) las da
# tu Entidad / Wipay al dar de alta el comercio. Sin ellas el adapter
# lanza "credentials no configuradas" — no impide arrancar el API.
WIPAY_API_URL=https://tpv.ceca.es/tpvweb/tpv/compra.action
WIPAY_MERCHANT_ID=
WIPAY_ACQUIRER_BIN=
WIPAY_TERMINAL_ID=
WIPAY_CLAVE_ENCRIPTACION=
# WIPAY_WEBHOOK_SECRET — DEPRECATED (el adapter no lo usa, Cecabank firma
# con SHA-256 sobre los campos + clave_encriptación). Mantener vacío.
WIPAY_WEBHOOK_SECRET=

# Redsys SIS = el TPV de BBVA (y otros bancos ES). 3 credenciales:
#   - REDSYS_MERCHANT_CODE: código comercio "FUC" (entero, 9 dígitos)
#   - REDSYS_TERMINAL: nº terminal (típicamente 1, 2, 3...)
#   - REDSYS_SECRET_KEY: clave de firma base64 del banco
# Sandbox URL: https://sis-t.redsys.es:25443/sis/realizarPago
# Prod URL:    https://sis.redsys.es/sis/realizarPago
# Algunos bancos usan subdominio propio (bbvaempresas.redsys.es).
REDSYS_API_URL=https://sis-t.redsys.es:25443/sis/realizarPago
REDSYS_MERCHANT_CODE=
REDSYS_TERMINAL=
REDSYS_SECRET_KEY=
PEANPE_API_URL=http://localhost:4902
PEANPE_WEBHOOK_SECRET=dev_peanpe_secret

# ── Peanpe API v2.0 (doc oficial — implementación real) ─────────────
# PEANPE_API_KEY se entrega en HEX por personal de Peanpe (1 sola vez).
# El adapter hace HMAC-SHA256 con la apikey convertida a bytes raw.
PEANPE_API_BASE_URL=http://peanpe.com
PEANPE_API_KEY=
PEANPE_ACCOUNT_ID=
# URL pblica que configurarás en Peanpe como "Webservice Comunicación".
# Dev: usar ngrok. Prod: https://api.tudominio.com/v1/webhooks/peanpe/notify
PEANPE_WEBHOOK_URL=
# URL pblica donde el cliente aterriza tras pagar (ThankYou page).
PEANPE_THANKYOU_URL=

# ── Paytef Payment LINK (Track B) ────────────────────────────────────
# Obtener token en my.paytef.es → API de Payment LINK → "Habilitar API".
# Pegar SOLO el token (sin prefijo "PAYTEF-TOKEN "). El adapter lo añade.
PAYTEF_API_URL=https://api.paytef.es/gcf
PAYTEF_API_TOKEN=
# Secret compartido para webhooks (URL secreta). Generar con `openssl rand -hex 32`.
PAYTEF_WEBHOOK_SECRET=
# URL pública de NightPay que Paytef llama tras pago. Se configura en
# notifyResultURL del body de /payment-link/save. Para dev: usar ngrok.
PAYTEF_WEBHOOK_URL=
# URL pública del frontend cliente para redirect tras pago.
PAYTEF_RETURN_URL=

# ── Frontends ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_WS_URL=ws://localhost:4100

# ── Observability (opcional en dev) ──────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nightpay-api
