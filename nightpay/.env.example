# NightPay — plantilla de entorno (copia a .env.local y edita)
# No commits de .env.local (gitignored)

# ── Core ────────────────────────────────────────────────────────────
# Puerto API: 4100 (rango 4xxx, dev limpio sin conflictos)
NODE_ENV=development
PORT=4100
LOG_LEVEL=debug

# ── Database (Docker Compose dev) ────────────────────────────────────
# Host port 4432 → container 5432 (evita conflicto con cualquier otro Postgres)
DATABASE_URL=postgresql://np:np@localhost:4432/nightpay?schema=public

# ── Redis (cache + BullMQ + Socket.io adapter) ───────────────────────
# Host port 4379 → container 6379
REDIS_URL=redis://localhost:4379

# ── Auth & crypto ────────────────────────────────────────────────────
# ROTAR en producción: usar `openssl rand -hex 32` o equivalente.
# Valores aquí: 64 chars hex (32 bytes) — válidos para desarrollo local SOLO.
JWT_SECRET=dev_jwt_a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6_v1
COOKIE_SECRET=dev_cookie_a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6_v1
# KEK (Key Encryption Key) para cifrar credenciales de pasarela en DB
# ROTAR en producción con `openssl rand -base64 32`
ENCRYPTION_KEK=dev_kek_a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6_v1

# ── Gateways (mocks en dev) ──────────────────────────────────────────
WIPAY_API_URL=http://localhost:4901
WIPAY_WEBHOOK_SECRET=dev_wipay_secret
PEANPE_API_URL=http://localhost:4902
PEANPE_WEBHOOK_SECRET=dev_peanpe_secret

# ── Frontends ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_WS_URL=ws://localhost:4100

# ── Observability (opcional en dev) ──────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=nightpay-api
