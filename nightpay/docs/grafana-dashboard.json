{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "short"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "Pagos creados / min (por venue)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (venue) (rate(nightpay_payments_created_total[1m]) * 60)",
          "legendFormat": "{{venue}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.85 },
              { "color": "green", "value": 0.95 }
            ]
          },
          "unit": "percentunit",
          "max": 1,
          "min": 0
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Tasa exito autorizacion (5m)",
      "type": "stat",
      "options": { "colorMode": "background", "graphMode": "area" },
      "targets": [
        {
          "expr": "sum(rate(nightpay_payments_transitioned_total{to=\"AUTHORIZED\"}[5m])) / sum(rate(nightpay_payments_transitioned_total{from=\"AUTHORIZING\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineInterpolation": "linear", "lineWidth": 2 },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Latencia gateway p95 (por provider+op)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (provider, op, le) (rate(nightpay_gateway_call_duration_seconds_bucket[5m])))",
          "legendFormat": "{{provider}}/{{op}} p95",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "CLOSED", "color": "green" } } },
            { "type": "value", "options": { "1": { "text": "HALF-OPEN", "color": "yellow" } } },
            { "type": "value", "options": { "2": { "text": "OPEN", "color": "red" } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 2 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Estado circuit breakers",
      "type": "stat",
      "options": { "colorMode": "background", "graphMode": "none" },
      "targets": [
        {
          "expr": "nightpay_circuit_state",
          "legendFormat": "{{provider}}/{{op}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 16 },
      "id": 5,
      "title": "Logins por outcome (5m)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (outcome) (rate(nightpay_auth_logins_total[5m]) * 60)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 16 },
      "id": 6,
      "title": "Webhooks por outcome",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (provider, outcome) (rate(nightpay_webhooks_received_total[5m]) * 60)",
          "legendFormat": "{{provider}}/{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 16 },
      "id": 7,
      "title": "Refunds por status",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (status, provider) (rate(nightpay_refunds_created_total[5m]) * 60)",
          "legendFormat": "{{provider}}/{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 24 },
      "id": 8,
      "title": "Conexiones WS activas",
      "type": "stat",
      "targets": [{ "expr": "nightpay_ws_connections_active", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 6, "w": 16, "x": 8, "y": 24 },
      "id": 9,
      "title": "Profundidad colas BullMQ",
      "type": "timeseries",
      "targets": [
        {
          "expr": "nightpay_queue_depth",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 30 },
      "id": 10,
      "title": "Transiciones FSM (heatmap)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "sum by (from, to) (rate(nightpay_payments_transitioned_total[5m]) * 60)",
          "legendFormat": "{{from}} → {{to}}",
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 38,
  "tags": ["nightpay", "production"],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": false, "text": "grafanacloud-prom", "value": "grafanacloud-prom" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "Europe/Madrid",
  "title": "NightPay — Operations",
  "uid": "nightpay-ops",
  "version": 1,
  "weekStart": ""
}
