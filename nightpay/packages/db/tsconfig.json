{
  "extends": "../config/tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "outDir": "dist",
    "composite": true,
    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "prisma/seed.ts", "scripts/**/*.ts"],
  "exclude": ["src/generated", "node_modules", "dist"]
}
