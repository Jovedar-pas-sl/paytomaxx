{
  "name": "@nightpay/db",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env.local -- prisma generate",
    "migrate": "dotenv -e ../../.env.local -- prisma migrate deploy",
    "migrate:dev": "dotenv -e ../../.env.local -- prisma migrate dev",
    "migrate:reset": "dotenv -e ../../.env.local -- prisma migrate reset --force",
    "seed": "dotenv -e ../../.env.local -- tsx prisma/seed.ts",
    "studio": "dotenv -e ../../.env.local -- prisma studio",
    "cli": "dotenv -e ../../.env.local -- tsx scripts/cli.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "clean": "rm -rf dist src/generated"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "bcryptjs": "^2.4.3",
    "ioredis": "^5.4.1",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "@nightpay/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/speakeasy": "^2.0.10",
    "dotenv-cli": "^7.4.2",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "dotenv -e ../../.env.local -- tsx prisma/seed.ts"
  }
}
