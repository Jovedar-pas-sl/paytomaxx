// NightPay — schema Prisma v1 (Sprint 1)
// Docs: ver nightpay/docs/MASTER_PLAN_V2.md §5

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  // native = local dev (Windows/Mac/Linux); linux-musl-openssl-3.0.x = Alpine en Docker
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Tenants & Users ─────────────────────────

model Venue {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String    @unique
  timezone              String    @default("Europe/Madrid")
  // Tope de importe para cobros creados por OPERATOR (default 200€).
  // OWNER/MANAGER ignoran este cap. El cap global de 10.000€ del Zod schema sigue.
  operatorMaxCobroCents Int       @default(20000)
  // Comisión NightPay en basis points (default 1000 = 10%).
  // Modelo: chica recibe su commissionBps; plataforma recibe platformCommissionBps.
  platformCommissionBps Int       @default(1000)
  // Comisiones por defecto al operator/staff que crea el cobro, por categoría de ingreso.
  // Shape: { CHICA_SERVICE: 9000, VENUE_BAR: 0, VENUE_ROOM: 0, VENUE_FOOD: 0, EXTRA: 0 }
  // Override por chica: User.commissionBps aplica SOLO a CHICA_SERVICE.
  // Las categorías VENUE_* siempre usan el default del venue (es ingreso del local).
  operatorCommissionDefaults Json  @default("{\"CHICA_SERVICE\":9000,\"VENUE_BAR\":0,\"VENUE_ROOM\":0,\"VENUE_FOOD\":0,\"EXTRA\":0}")
  // IVA aplicado a la base imponible (basis points). Default 2100 = 21% (general).
  // Hostelería: 10% (1000) bebidas y comida + 21% (2100) bebidas alcohólicas.
  // Para simplificar Phase 1: un único tipo por venue (admin elige el dominante).
  // Modelo 303 trimestral usa este valor.
  vatBps                Int       @default(2100)
  // Régimen IVA: GENERAL, RECARGO_EQUIVALENCIA (típico hostelería pequeña),
  // EXENTO (no aplica IVA — actividades no sujetas). Default GENERAL.
  vatRegime             String    @default("GENERAL")
  // Saldo NightPay: locales del mismo grupo (mismo dueño) comparten el saldo del cliente.
  walletGroup           String?
  // Consola del super-admin (20261016100000): negocio cliente al que pertenece.
  businessId            String?   @db.Uuid
  // Local en pausa (o su negocio): sin cobros, recargas ni cobros del saldo nuevos (423 VENUE_PAUSED).
  pausedAt              DateTime? @db.Timestamptz
  pausedReason          String?
  // IBAN donde el banco liquida los cobros con tarjeta (sin espacios, mod-97 en el API).
  settlementIban        String?
  settlementHolder      String?
  // Días de espera antes de pagar a las chicas (0-60). Null = PAYOUT_HOLD_DAYS del entorno.
  payoutHoldDays        Int?
  // Reglas de aprobación (las aplica la bandeja de aprobaciones): devoluciones
  // desde este importe y pagos a las chicas los pide el encargado y los aprueba el dueño con 2FA.
  refundApprovalThresholdCents Int     @default(10000)
  payoutRequiresApproval       Boolean @default(true)
  // Ajustes del dueño (20261020100000), JSON validado en el API
  // (packages/contracts/src/venue-settings.ts). Null = lo de siempre.
  // Formas de cobro encendidas y propinas.
  paymentMethods        Json?
  // Permisos del personal (por rol y por persona).
  staffPermissions      Json?
  // Avisos de Telegram: grupos, chat del local y nombres de las chicas.
  alertSettings         Json?
  // Secciones del local (20261023100000): { enabled, label, color } por
  // sección (packages/contracts/src/sections.ts). Null = las de fábrica.
  sections              Json?
  // Qué cobra cada puesto (20261023100100): secciones, propinas, efectivo y
  // recargas (packages/contracts/src/post-rules.ts). Null = lo de fábrica.
  postRules             Json?
  // «Copa con invitación» (20261023100200): parte de la chica y del camarero
  // (% o fijo). Null = lo de fábrica (packages/contracts/src/invitations.ts).
  invitationRules       Json?
  // Ajustes de la noche (20261023200000, packages/contracts/src/night-settings.ts):
  // NFC sin PIN, teclado del PIN, recepción y avisos al cobrar. Null = de fábrica.
  nightSettings         Json?
  // «Comisión del servicio» (20261030100000, packages/contracts/src/service-fee.ts):
  // lo que paga el cliente ENCIMA del precio (ingreso de OxioPay). Solo con el
  // interruptor encendido (lo enciende el super-admin con 2FA; apagado = todo
  // como antes, también el % antiguo de la plataforma). Los dos % de 0 a 1200
  // (CHECK en SQL): pagos directos con tarjeta o datáfono, y recargas del saldo.
  serviceFeeEnabled     Boolean   @default(false)
  serviceFeeBps         Int       @default(1000)
  topUpServiceFeeBps    Int       @default(1000)
  // «Cargar saldo desde casa» (20261103100000, apps/api/src/modules/home-topup):
  // el enlace público del local (/r/<código>) para cargar el saldo antes de
  // llegar. Apagado de serie; el código es al azar (16 letras de base64url) y
  // «Enlace nuevo» lo cambia. CHECK en SQL: encendido ⇒ con código.
  homeTopUpEnabled      Boolean   @default(false)
  homeTopUpCode         String?   @unique
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz
  deletedAt             DateTime? @db.Timestamptz

  business           Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  users              User[]
  terminals          Terminal[]
  gatewayCredentials GatewayCredential[]
  payments           Payment[]
  operatorEarnings   OperatorEarning[]
  operatorPayouts    OperatorPayout[]
  clientWallets      ClientWallet[]
  walletConsumptions WalletConsumption[]
  peanpeCalls        PeanpeCall[]
  serviceItems       ServiceItem[]
  serviceItemImages  ServiceItemImage[]
  btcpayStore        BtcpayStore?
  btcpayInvoices     BtcpayInvoice[]
  walletPushSubscriptions WalletPushSubscription[]
  userPhotos         UserPhoto[]
  nights             VenueNight[]
  incidentAcks       IncidentAck[]
  posTerminalOps     PosTerminalOp[]
  approvalRequests   ApprovalRequest[]
  walletCashTopUps   WalletCashTopUp[]
  walletCards        WalletCard[]
  walletCardEvents   WalletCardEvent[]
  paymentLines       PaymentLine[]
  chargeRefCounter   ChargeRefCounter?
  oxioPaySettlements OxioPaySettlement[]

  @@index([businessId])
  @@map("venues")
}

enum BusinessStatus {
  ACTIVE
  PAUSED
}

// Negocio cliente de OxioPay (razón social con sus locales). Global, sin local:
// solo lo gestiona el super-admin (acrossVenues; RLS solo con bypass).
// En pausa: ninguno de sus locales acepta cobros nuevos.
model Business {
  id                           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                         String
  // NIF/CIF en mayúsculas, sin espacios ni guiones.
  taxId                        String?        @unique
  contactName                  String?
  contactEmail                 String?
  contactPhone                 String?
  notes                        String?
  status                       BusinessStatus @default(ACTIVE)
  pausedAt                     DateTime?      @db.Timestamptz
  pausedReason                 String?
  // Comisión de la plataforma para sus locales nuevos (null = la general del local).
  defaultPlatformCommissionBps Int?
  // «Comisión del servicio» para sus locales nuevos (null = la de fábrica, 10 %).
  // De 0 a 1200 (CHECK en SQL). El interruptor de cada local va aparte (apagado).
  defaultServiceFeeBps         Int?
  defaultTopUpServiceFeeBps    Int?
  createdAt                    DateTime       @default(now()) @db.Timestamptz
  updatedAt                    DateTime       @default(now()) @updatedAt @db.Timestamptz

  venues             Venue[]
  oxioPaySettlements OxioPaySettlement[]

  @@map("businesses")
}

enum Role {
  OWNER
  MANAGER
  WAITER
  OPERATOR
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  email        String    @unique
  passwordHash String
  role         Role
  totpSecret   String?
  // Solo aplica cuando role = OPERATOR. 1500 bps = 15.00%
  commissionBps Int?
  // Super admin "extra-tenant": puede listar/crear todos los locales y switchear
  // su JWT entre venues. tenantId del User sigue apuntando a su venue primario.
  // El flag se setea via CLI (pnpm cli set-super-admin --email X). NO via UI.
  isSuperAdmin  Boolean   @default(false)
  // Nombre visible para admin (ej. "Ana", "Marina"). Solo OPERATOR.
  displayName  String?
  // Marca de invitacion pendiente — null cuando ya activo password.
  invitedAt    DateTime?
  // JWT de un solo uso para set-password. Limpio al aceptar la invitacion.
  inviteToken  String?   @unique
  // sha256 hash del JWT self-onboarding (TTL 72h). Admin genera el link para
  // que la chica rellene su perfil ella sola si sabe manejar la web + KYC.
  selfOnboardingToken String? @unique
  // Phase 1A — routing de payout. Solo OPERATOR. Valores en migration 20260511 comment.
  // Si payoutMethod es null el modal "Marcar pagado" cae a MANUAL_CASH.
  payoutMethod   String?
  payoutAddress  String?
  payoutMetadata Json?
  payoutLabel    String?
  // Tip beneficiary relation (cliente añade propina dirigida a esta operadora/staff)
  tipsReceived        Payment[]           @relation("PaymentTipBeneficiary")

  // Phase 1A.1 — onboarding tracking (solo OPERATOR)
  phone               String?
  passportCountry     String?
  passportLast4       String?
  hasEmpadronamiento  Boolean @default(false)
  hasNie              Boolean @default(false)
  hasTie              Boolean @default(false)
  walletProvider      String?
  walletStatus        String?
  walletTestPassed    Boolean @default(false)
  walletTestAt        DateTime? @db.Timestamptz
  needsHelpWallet     Boolean @default(false)
  needsHelpDocs       Boolean @default(false)
  onboardingStatus    String  @default("NEW")
  onboardingNotes     String?
  // Puesto (20261023100000): SALA | BARRA | HABITACIONES | COCINA | RECEPCION.
  // Da la sección por defecto de sus cobros (Sala → Servicios, Barra →
  // Copas…). Null = el de su rol (chica → Sala, resto → Barra).
  post                String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  deletedAt    DateTime? @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id])

  // Relaciones para OPERATOR
  earnings              OperatorEarning[]   @relation("OperatorEarnings")
  payouts               OperatorPayout[]    @relation("OperatorPayouts")
  payoutsPaid           OperatorPayout[]    @relation("PayoutsPaid")
  payoutsReconciled     OperatorPayout[]    @relation("PayoutsReconciled")
  paymentsCreated       Payment[]           @relation("PaymentCreatedBy")
  // Phase 1B — wallet consumptions cobrados por este usuario
  providedConsumptions  WalletConsumption[] @relation("ConsumptionProvider")
  reversedConsumptions  WalletConsumption[] @relation("ConsumptionReversedBy")
  // «Copa con invitación»: las líneas en las que la invitaron.
  invitedLines          PaymentLine[]       @relation("PaymentLineBeneficiary")
  // Sus llaves de acceso (20261109100000): verificarse sin 2FA.
  staffPasskeys         StaffPasskey[]
  // Su foto de perfil (20261113100000).
  photo                 UserPhoto?

  @@unique([id, tenantId])
  @@index([tenantId])
  @@map("users")
}

model Terminal {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @db.Uuid
  externalId String
  label      String
  active     Boolean @default(true)

  // Track A — agrupador físico para routing en venues con 6-8 PAX.
  //   - Valores enum: BARRA, HABITACIONES, MESAS, OTRO (validados en app, no DB).
  //   - "OTRO/<custom>" permitido cuando admin necesita zona personalizada.
  //   - NULL = terminal legacy sin zona asignada (backward compat).
  zone          String?
  // Modelo hardware: "PAX_A920_PRO" | "OTRO" (futuro: REDSYS_VX, INGENICO...).
  hardwareModel String?
  // S/N físico del datáfono — futuro mapping con Paytef Terminal ID.
  deviceSerial  String?
  // App NightPay en el datáfono (Paytef Device API): credencial del aparato
  // (solo el hash) y código de vinculación de un solo uso.
  deviceTokenHash      String?   @unique
  devicePairedAt       DateTime? @db.Timestamptz
  deviceLastSeenAt     DateTime? @db.Timestamptz
  pairingCodeHash      String?   @unique
  pairingCodeExpiresAt DateTime? @db.Timestamptz
  // Rotación de la credencial: la nueva convive con la anterior hasta que el
  // datáfono la usa (si no le llega la respuesta, la anterior sigue valiendo).
  // Fecha de la credencial en uso, para la caducidad opcional
  // (POS_DEVICE_TOKEN_MAX_AGE_DAYS; sin ella, no caduca).
  deviceTokenNextHash  String?   @unique
  deviceTokenIssuedAt  DateTime? @db.Timestamptz
  // Fecha de la credencial nueva (rotación): pasa a deviceTokenIssuedAt solo
  // cuando el datáfono la usa. Rotar no rejuvenece la credencial en uso.
  deviceTokenNextIssuedAt DateTime? @db.Timestamptz
  // Datáfono de la recepción: el único que cobra recargas en efectivo (el
  // datáfono no sabe quién lo lleva). Lo marca el dueño en Datáfonos.
  reception            Boolean   @default(false)

  venue    Venue     @relation(fields: [tenantId], references: [id])
  payments Payment[]
  posOps   PosTerminalOp[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, zone])
  @@map("terminals")
}

// ───────────────────────── Gateway credentials ─────────────────────

enum Provider {
  WIPAY   // ESP Global Payment Systems — acquirer; sin claves activas
  PEANPE  // pasarela alternativa; sin claves activas
  PAYTEF  // pasarela omnicanal Paytef (Payment LINK API) — único activo hoy
  REDSYS  // Redsys SIS — protocolo estándar de bancos ES (BBVA, Santander,
          // CaixaBank, Sabadell). Form POST hosted + HMAC-SHA256-3DES.
  BTCPAY  // BTCPay Server del propio local: «Pagar con bitcoin». No es la
          // pasarela de tarjeta del local, es una forma de pago más.
}

// «Pagar con bitcoin» (BTCPay Server): la conexión de CADA local a SU BTCPay.
// La clave de API y el secreto del aviso van cifrados (AES-256-GCM, clave
// derivada de ENCRYPTION_KEK) y no vuelven nunca al navegador. FORCE RLS: solo
// dentro de una transacción de PrismaService.
model BtcpayStore {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String    @unique @db.Uuid
  baseUrl            String
  storeId            String
  apiKeyEnc          String
  webhookSecretEnc   String?
  webhookId          String?
  // Token aleatorio de la ruta del aviso: identifica al local antes de verificar la firma.
  hookToken          String    @unique
  enabled            Boolean   @default(false)
  // PAYMENTS (cobros) | TOPUPS (recargas) | BOTH
  purpose            String    @default("BOTH")
  lastCheckAt        DateTime? @db.Timestamptz
  lastCheckOk        Boolean?
  lastCheckMessage   String?
  createdAt          DateTime  @default(now()) @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("btcpay_stores")
}

// Las facturas de bitcoin de los cobros. Una abierta (New/Processing) por cobro.
// FORCE RLS como el resto del dinero del local.
model BtcpayInvoice {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  paymentId      String    @db.Uuid
  invoiceId      String    @unique
  storeId        String
  // New | Processing | Settled | Expired | Invalid
  status         String    @default("New")
  // None | PaidLate | PaidPartial | Marked | PaidOver
  additionalStatus String?
  // Lo facturado en céntimos de euro (importe + comisión del servicio).
  amountCents    Int
  // Importe en BTC (texto decimal) y cambio EUR por BTC al crear la factura.
  amountBtc      String?
  rate           String?
  checkoutLink   String
  // El enlace del QR: bitcoin normal y Lightning juntos si la tienda tiene los dos.
  qrLink         String
  chainAddress   String?
  expiresAt      DateTime  @db.Timestamptz
  closedAt       DateTime? @db.Timestamptz
  lastCheckedAt  DateTime? @db.Timestamptz
  createdAt      DateTime  @default(now()) @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @db.Timestamptz

  venue   Venue   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([paymentId])
  @@map("btcpay_invoices")
}

// «Aviso en cada cobro» (20261117200000): cada navegador que el cliente apunta
// para recibir un aviso (Web Push) en cada cobro de su saldo o de su ficha.
// Solo la dirección del servicio de avisos y sus claves públicas; nada del
// cliente. FORCE RLS: solo dentro de una transacción de PrismaService.
model WalletPushSubscription {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @db.Uuid
  walletId   String    @db.Uuid
  endpoint   String
  p256dh     String
  auth       String
  // es | en | fr | pt: el idioma de la página al apuntarse (el del aviso).
  lang       String    @default("es")
  failCount  Int       @default(0)
  lastSentAt DateTime? @db.Timestamptz
  createdAt  DateTime  @default(now()) @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamptz

  venue  Venue        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([walletId, endpoint])
  @@index([endpoint])
  @@index([tenantId])
  @@map("wallet_push_subscriptions")
}

model GatewayCredential {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  provider   Provider
  // Credenciales cifradas AES-256-GCM
  encKey     Bytes
  encNonce   Bytes
  encTag     Bytes
  kekVersion Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, active])
  @@map("gateway_credentials")
}

// ───────────────────────── Payments ────────────────────────────────

enum PaymentStatus {
  CREATED
  AWAITING_CAPTURE
  AUTHORIZING
  AUTHORIZED
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  ORPHAN
  CANCELED
}

// Peanpe mapping table — Peanpe limita identificador_llamada a 6 chars.
// Persistimos el mapping payment.id (UUID) ↔ identificador_llamada (6 chars)
// + el securityToken para validar el challenge-response del webhook.
model PeanpeCall {
  identificadorLlamada String    @id @map("identificador_llamada")
  paymentId            String    @unique @db.Uuid
  tenantId             String    @db.Uuid
  securityToken        String
  amountCents          Int
  resultStatus         String?
  resultMsg            String?
  resultReceivedAt     DateTime? @db.Timestamptz
  createdAt            DateTime  @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("peanpe_calls")
}

model Payment {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String        @db.Uuid
  terminalId           String        @db.Uuid
  // Set por payments.service cuando hay request context con userId.
  // null cuando origen no humano (cron, webhook reconcile, etc.).
  createdByUserId      String?       @db.Uuid
  idempotencyKey       String
  // Huella (sha256) de quién creó el cobro + lo que pidió: la misma
  // Idempotency-Key con otra persona u otra petición → 409. Null = cobro de
  // antes de guardarla (solo se compara quién lo creó).
  idempotencyHash      String?
  amountCents          Int
  currency             String        @default("EUR") @db.Char(3)
  status               PaymentStatus @default(CREATED)
  provider             Provider?
  providerTxId         String?
  qrToken              String        @unique
  qrExpiresAt          DateTime      @db.Timestamptz
  availableAmountCents Int
  createdAt            DateTime      @default(now()) @db.Timestamptz
  updatedAt            DateTime      @updatedAt @db.Timestamptz

  // Modo de cobro usado: "QR" | "WALLET_TOPUP". Null para payments antiguos (asume QR).
  captureMethod String?

  // Categoría contable del cobro: CHICA_SERVICE | VENUE_BAR | VENUE_ROOM | VENUE_FOOD | EXTRA.
  // Determina (a) si genera earning para la chica creator y a qué bps, y
  // (b) cómo se agrega en el Z-report (split chicas vs local).
  // CHICA_SERVICE: usa User.commissionBps (override) o Venue.operatorCommissionDefaults.CHICA_SERVICE
  // VENUE_*     : siempre usa Venue.operatorCommissionDefaults[<categoría>]
  revenueCategory String  @default("EXTRA")

  // Phase 1B — si este Payment es el top-up de un ClientWallet, walletId apunta
  // a la wallet creada/recargada. Cuando Payment llega a AUTHORIZED, el balance
  // de la wallet se suma atómicamente.
  walletId String? @db.Uuid

  // Snapshot del % plataforma al momento del cobro. Si Venue.platformCommissionBps
  // cambia mañana, contabilidad histórica usa este valor congelado.
  platformCommissionBps Int?
  // Snapshot del % de la chica (OPERATOR) al crear el cobro: su commissionBps
  // o el del local para la categoría. Al pagarse se usa este, no el de ese
  // momento. Null = cobro anterior o que no es de una chica (se calcula al pagar).
  operatorCommissionBps Int?
  // «Comisión del servicio» (20261030100000): el % fijado al crear el cobro
  // (null = sin comisión: el interruptor del local apagado, o un cobro de antes)
  // y su importe, ENCIMA de amountCents (que sigue siendo el consumo o, en una
  // recarga, el saldo). Al banco o al datáfono va amountCents + serviceFeeCents
  // + tipCents. En un pago directo es devolvible (availableAmountCents la
  // incluye); en una recarga no («Devolver saldo» devuelve solo el saldo).
  // Con la comisión, platformCommissionBps se fija a 0 (el local ya no paga el
  // % antiguo). CHECK en SQL: % NULL o 0–1200 e importe ≥ 0.
  serviceFeeBps         Int?
  serviceFeeCents       Int     @default(0)

  // Propina opcional (cliente decide añadir). Campos:
  //  - tipCents: importe extra sobre amountCents (no entra en availableAmountCents
  //              base, va a tipBeneficiary).
  //  - tipGoesTo: política — 'operator' (chica creator), 'venue' (local), 'shared',
  //              'beneficiary' (usa tipBeneficiaryUserId explícito).
  //  - tipBeneficiaryUserId: override del beneficiario cuando tipGoesTo='beneficiary'.
  tipCents              Int     @default(0)
  tipGoesTo             String?
  tipBeneficiaryUserId  String? @db.Uuid

  // URL del payment-link/checkout del PSP. NightPay redirige al cliente aquí
  // cuando escanea el QR. Se popula al primer startAuthorization() exitoso.
  gatewayPaymentUrl    String?

  // Para PSPs que esperan form POST desde el navegador (Cecabank/Wipay TPV
  // Virtual, Redsys, etc.) en vez de redirect. Shape:
  //   { action: string, method: "POST", fields: Record<string,string> }
  // Persistido para que un refresh del /pay/{token} no regenere firmas
  // distintas (Cecabank rechaza Num_operacion duplicado).
  gatewayCheckoutForm  Json?

  // Datos de tokenización capturados del callback PSP cuando el cobro pidió
  // crear un token de tarjeta para cobros recurrentes (PIN-flow). Shape:
  //   { identifier: string, expiry: string, cardLast4: string,
  //     cardBrand: string, cofTxnId: string, capturedAt: string (ISO) }
  // El identifier es el token reusable (NO el PAN). NightPay nunca almacena
  // PAN ni CVV — eso lo gestiona el PSP. SAQ-A compliant.
  tokenizationData     Json?

  // Fase 0 — datos que manda el banco al aprobar (aviso Redsys o confirmación
  // de datáfono). payMethodCode = Ds_ProcessedPayMethod tal cual (sin mapear
  // hasta confirmar los códigos de Apple/Google Pay con BBVA).
  payMethodCode String?
  cardBrand     String?
  cardType      String?
  cardCountry   String?
  cardLast4     String?
  authCode      String?
  secure3ds     Boolean?
  authorizedAt  DateTime? @db.Timestamptz

  // Fase 1A — foto del servicio de la carta (si el cobro salió de ella).
  serviceItemId String?   @db.Uuid
  serviceName   String?
  // Datáfono PAX: número de operación de Paytef y datáfono que lo cobró (el
  // par es único: una operación paga un solo cobro).
  posOperationNumber String?
  posTerminalId      String? @db.Uuid
  durationMin   Int?
  // Referencia corta por local (C-0001), del contador charge_ref_counters
  // (compartido con los cobros del saldo). Null en los cobros antiguos.
  ref           Int?

  venue              Venue            @relation(fields: [tenantId], references: [id])
  terminal           Terminal         @relation(fields: [terminalId], references: [id])
  createdBy          User?            @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  wallet             ClientWallet?    @relation(fields: [walletId], references: [id])
  tipBeneficiary     User?            @relation("PaymentTipBeneficiary", fields: [tipBeneficiaryUserId], references: [id])
  events             PaymentEvent[]
  refunds            Refund[]
  operatorEarnings   OperatorEarning[]
  peanpeCall         PeanpeCall?
  attempts           PaymentAttempt[]
  lines              PaymentLine[]
  btcpayInvoices     BtcpayInvoice[]
  // Cobro único: la otra forma de pagar este mismo cobro (el saldo).
  linkedWalletCharge WalletChargeRequest? @relation("CobroUnico")

  @@unique([tenantId, idempotencyKey])
  @@unique([tenantId, ref])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, createdByUserId, createdAt(sort: Desc)])
  @@index([providerTxId])
  @@index([qrExpiresAt])
  // CHECK solo en SQL (20261029400100_check_dinero): amountCents > 0 y los dos
  // % (platformCommissionBps, operatorCommissionBps) NULL o de 0 a 10000.
  // Solo en SQL (20261029400000_indices_informes; Prisma no los compara):
  // payments_tenant_paid_at_idx (tenantId, COALESCE(authorizedAt, createdAt)),
  // el «momento del cobro» de los informes; y payments_open_qr_expires_idx
  // (qrExpiresAt) de los CREATED/AWAITING_CAPTURE, para el barrido de caducados.
  @@index([walletId])
  @@index([tipBeneficiaryUserId])
  @@unique([posTerminalId, posOperationNumber])
  @@map("payments")
}

// Fase 0 — un intento = un pedido en la pasarela (Redsys Ds_Order). Un pago
// puede tener varios (reintento con otra tarjeta). No es tenant-scoped en el
// middleware: se accede vía asSystem (cliente sin login, avisos del banco).
model PaymentAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId    String   @db.Uuid
  tenantId     String   @db.Uuid
  provider     Provider
  providerTxId String
  // PENDING | APPROVED | DENIED
  status       String   @default("PENDING")
  responseCode String?
  // Fase 1B: lo que se mandó al banco en este intento (NULL = antes de 1B).
  amountCents  Int?
  tipCents     Int?
  // wallet (Apple Pay / Google Pay) | card
  payMethod    String?
  // Huella de la cookie del navegador que abrió el intento (enlace del saldo).
  claimHash    String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([paymentId, createdAt(sort: Desc)])
  @@map("payment_attempts")
}

// Saldo NightPay — cobro del saldo que el cliente acepta en su móvil.
// tenantId = local donde se cobra (puede ser otro local del mismo grupo).
model WalletChargeRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @db.Uuid
  // Null en un cobro con QR hasta que el cliente lo paga con su Face ID.
  walletId          String?   @db.Uuid
  requestedByUserId String    @db.Uuid
  amountCents       Int
  category          String
  serviceName       String?
  // PENDING | ACCEPTED | REJECTED | EXPIRED | CANCELED
  status            String    @default("PENDING")
  expiresAt         DateTime  @db.Timestamptz
  decidedAt         DateTime? @db.Timestamptz
  consumptionId     String?   @db.Uuid
  // Cobro con QR: el token del enlace /s/<payToken> que escanea el cliente.
  payToken          String?   @unique
  // Referencia corta por local (C-0001), del mismo contador que los cobros.
  ref               Int?
  createdAt         DateTime  @default(now()) @db.Timestamptz
  // Cobro único (20261024100000): el cobro con tarjeta del que este es la
  // otra forma de pagar (NFC, PIN o Face ID). Mismo importe, misma referencia
  // y un solo juego de líneas (en el cobro con tarjeta hasta que paga el
  // saldo). Gana el primero que se paga, con la fila del cobro bloqueada: el
  // otro se cancela. Null = cobro del saldo suelto.
  linkedPaymentId   String?   @unique @db.Uuid
  // Propina que pidió el cliente (20261024100100), aparte del importe: el
  // saldo paga importe + propina y el consumo la guarda en su "tipCents".
  tipCents          Int       @default(0)

  wallet        ClientWallet? @relation(fields: [walletId], references: [id], onDelete: Cascade)
  linkedPayment Payment?      @relation("CobroUnico", fields: [linkedPaymentId], references: [id], onDelete: Cascade)
  lines         PaymentLine[]

  @@unique([tenantId, ref])
  @@index([walletId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wallet_charge_requests")
}

// Saldo NightPay — devolución del saldo al cliente que se va.
model WalletPayout {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  walletId      String   @db.Uuid
  amountCents   Int
  // CARD (hecha en el portal de BBVA) | CASH (en efectivo en el local)
  method        String
  bankReference String?
  note          String?
  paidByUserId  String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz
  // DONE (hecha) | PENDING (a la tarjeta, apuntándose en el banco: el saldo
  // ya salió de la wallet; se retoma si se quedó a medias). Una PENDING por
  // wallet (índice parcial wallet_payouts_one_pending_per_wallet). Las sumas
  // de lo devuelto, solo con DONE.
  status        String    @default("DONE")
  // Cuándo se empezó a apuntar (un segundo clic no la apunta dos veces).
  claimedAt     DateTime? @db.Timestamptz
  /// Reintento de una salida de recepción: nunca vuelve a sacar dinero.
  requestKey    String?
  /// Saldo tras esa salida (recibo estable aunque luego se recargue).
  remainingBalanceCents Int?

  wallet ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@unique([tenantId, requestKey])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wallet_payouts")
}

// Recarga del saldo en efectivo (recepción, 20261021100000). El efectivo no
// pasa por el banco: no es un Payment (ni FSM, ni devolución a la tarjeta, ni
// cuadre con el banco). Es la entrada simétrica a WalletPayout CASH: suma al
// saldo al momento y entra en la caja de la noche. tenantId = local que cobró
// (el de la caja; el saldo puede ser de otro local del grupo). Quién la cobró:
// la persona (takenByUserId) o el datáfono de recepción (terminalId), al menos
// uno (CHECK en SQL). La misma Idempotency-Key no carga dos veces.
// Anular una recarga (20261021200000) es otra fila, NEGATIVA, con voidOfId
// (una por recarga; CHECK de signo en SQL): resta en la caja, el Z y los
// informes como cualquier otra. FORCE RLS: solo dentro de una transacción.
model WalletCashTopUp {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String   @db.Uuid
  walletId       String   @db.Uuid
  amountCents    Int
  takenByUserId  String?  @db.Uuid
  terminalId     String?  @db.Uuid
  idempotencyKey String
  // Huella de lo pedido con la clave (destino tal como se pidió + importe) y
  // el recibo que se enseñó: un reintento con otra petición da 409 y el mismo
  // devuelve el mismo recibo, también si el saldo se sumó luego a otro. Null
  // en las anteriores a 20261026000000.
  intentFingerprint String?
  receipt           Json?
  createdAt      DateTime @default(now()) @db.Timestamptz
  /// La recarga abrió un saldo nuevo (aviso de saldos nuevos en efectivo seguidos).
  createdWallet  Boolean  @default(false)
  /// Anulación: la recarga que anula (la fila es negativa).
  voidOfId       String?  @unique @db.Uuid
  /// Por qué se anuló (solo en las anulaciones).
  reason         String?
  /// «Comisión del servicio» de la recarga (20261030100000): el % del momento
  /// (null = sin comisión) y su importe, ENCIMA de amountCents (el saldo). Entra
  /// en la caja y se debe a OxioPay. En una anulación, negativa (la de la recarga).
  serviceFeeBps   Int?
  serviceFeeCents Int     @default(0)

  venue    Venue            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  wallet   ClientWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)
  voidOf   WalletCashTopUp? @relation("CashTopUpVoid", fields: [voidOfId], references: [id], onDelete: Cascade)
  voidedBy WalletCashTopUp? @relation("CashTopUpVoid")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([walletId, createdAt])
  @@map("wallet_cash_topups")
}

// Datáfono PAX — operaciones del cierre de jornada del datáfono, para cuadrar.
model PosTerminalOp {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @db.Uuid
  terminalId      String    @db.Uuid
  operationNumber String
  opType          String
  amountCents     Int?
  occurredAt      DateTime? @db.Timestamptz
  reportedAt      DateTime  @default(now()) @db.Timestamptz

  venue    Venue    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@unique([terminalId, operationNumber])
  @@map("pos_terminal_ops")
}

// Fase 1E — incidencias que el dueño ya revisó (las incidencias se calculan al vuelo).
model IncidentAck {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @db.Uuid
  kind     String
  refId    String
  ackedBy  String?  @db.Uuid
  note     String?
  ackedAt  DateTime @default(now()) @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, refId])
  @@map("incident_acks")
}

// «Por aprobar» (20261016300000): el encargado pide pagos a las chicas (si el
// local tiene payoutRequiresApproval) y devoluciones desde
// refundApprovalThresholdCents; el dueño las aprueba con 2FA y quien pide no
// aprueba. `payload` lleva lo necesario para hacerlo luego (chica, método,
// cuenta tapada, comisiones y deudas que entran; o cobro, importe y motivo).
// Mientras está PENDING (y no ha caducado, 24 h) reserva: las comisiones de la
// chica no se pagan por otro lado y el importe del cobro no se devuelve dos veces.
// FORCE RLS (como operator_payouts): solo dentro de una transacción de PrismaService.
// Solo en SQL: índice único parcial (una pendiente por chica), índice parcial
// de las devoluciones pendientes por cobro y los CHECK (quien decide ≠ quien pide…).
model ApprovalRequest {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String         @db.Uuid
  kind          ApprovalKind
  status        ApprovalStatus @default(PENDING)
  // La chica (PAYOUT) o el cobro (REFUND).
  targetId      String         @db.Uuid
  amountCents   Int
  payload       Json
  requestedById String         @db.Uuid
  requestedAt   DateTime       @default(now()) @db.Timestamptz
  decidedById   String?        @db.Uuid
  decidedAt     DateTime?      @db.Timestamptz
  decisionNote  String?
  // Pago a la chica o devolución que salió al aprobarla.
  resultRef     String?        @db.Uuid
  failureReason String?
  updatedAt     DateTime       @default(now()) @updatedAt @db.Timestamptz
  // Idempotency-Key de quien lo pidió (pago a la chica): repetir la petición
  // sin respuesta devuelve la misma solicitud; otra petición con la misma, 409.
  idempotencyKey  String?
  idempotencyHash String?

  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@map("approval_requests")
}

enum ApprovalKind {
  PAYOUT
  REFUND
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  FAILED
}

// Fase 1D — noche del local: se abre y se cierra con informe Z congelado.
// Una sola abierta por local (índice parcial en SQL: venue_nights_one_open_per_venue).
model VenueNight {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  openedAt       DateTime  @default(now()) @db.Timestamptz
  openedBy       String?   @db.Uuid
  closedAt       DateTime? @db.Timestamptz
  closedBy       String?   @db.Uuid
  autoClosed     Boolean   @default(false)
  pendingAtClose Int       @default(0)
  closeNote      String?
  zReport        Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz
  // Cierre en pasos con arqueo (20261016400000): fondo de caja al abrir (o al
  // cerrar), lo que debería haber, lo contado y la diferencia (contado −
  // esperado). También van congelados en el Z (bloque «Caja»).
  openingFloatCents Int?
  cashCountedCents  Int?
  cashExpectedCents Int?
  cashDiffCents     Int?
  cashNote          String?

  // «Los más pedidos arriba» (20261112100000): { computedAt, units: { [productoId]: unidades } },
  // calculado una vez al pedir la carta por primera vez esa noche; null hasta entonces.
  cartaOrder Json?

  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, openedAt(sort: Desc)])
  @@map("venue_nights")
}

// Fase 1A — carta de servicios por local. La chica elige un servicio en vez
// de teclear importe; precio y categoría los fija el local.
model ServiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  durationMin Int?
  priceCents  Int
  // Sección: CHICA_SERVICE | VENUE_BAR | VENUE_ROOM | VENUE_FOOD | VENUE_ENTRY
  // (EXTRA solo en los antiguos).
  category    String   @default("CHICA_SERVICE")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  // Pack (20261023100000): [{ category, amountCents }] que suman priceCents
  // («1 h con habitación» = Servicios 120 € + Habitaciones 30 €). Null = de
  // una sola sección (category).
  components  Json?
  // «Copa con invitación» (20261023100200): en Copas, con su precio; la venta
  // se reparte con la chica invitada (venues.invitationRules).
  isInvitation Boolean @default(false)
  // Icono de la colección cerrada (CARTA_ICON_CODES, 20261111100000); null = el de su sección.
  icon        String?  @db.VarChar(24)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz

  venue        Venue              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  paymentLines PaymentLine[]
  image        ServiceItemImage?

  @@unique([id, tenantId])
  @@index([tenantId, active, sortOrder])
  @@map("service_items")
}

// Logo o foto del producto (20261111100000): WebP o PNG de 128×128 como mucho, en la
// base. La clave ajena lleva el local (una imagen no es de otro local que su
// producto). FORCE RLS: solo dentro de una transacción de PrismaService.
model ServiceItemImage {
  serviceItemId String   @id @db.Uuid
  tenantId      String   @db.Uuid
  contentType   String   @default("image/webp") @db.VarChar(16)
  data          Bytes
  contentHash   String   @db.Char(64)
  width         Int
  height        Int
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamptz

  item  ServiceItem @relation(fields: [serviceItemId, tenantId], references: [id, tenantId], onDelete: Cascade)
  venue Venue       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([serviceItemId, tenantId])
  @@index([tenantId])
  @@map("service_item_images")
}

// Foto de perfil del personal (20261113100000): WebP o JPEG de 256×256 como mucho y
// 150 KB, en la base. La clave ajena lleva el local. FORCE RLS: solo dentro de una
// transacción de PrismaService.
model UserPhoto {
  userId      String   @id @db.Uuid
  tenantId    String   @db.Uuid
  contentType String   @default("image/webp") @db.VarChar(16)
  data        Bytes
  contentHash String   @db.Char(64)
  width       Int
  height      Int
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz

  user  User  @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
  @@map("user_photos")
}

// El mapa del dinero (20261023100000): las líneas de cada cobro, cada una en
// su sección. De un cobro con tarjeta (paymentId) o de un cobro del saldo
// (walletChargeId), nunca de los dos (CHECK en SQL); nunca «Otros» (EXTRA).
// Un pack da una línea por parte. La comisión de la chica se calcula por
// línea. FORCE RLS: solo dentro de una transacción de PrismaService.
model PaymentLine {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String   @db.Uuid
  paymentId             String?  @db.Uuid
  walletChargeId        String?  @db.Uuid
  category              String
  serviceItemId         String?  @db.Uuid
  label                 String
  qty                   Int      @default(1)
  unitCents             Int
  amountCents           Int
  // % de la chica fijado al crear el cobro con tarjeta (#54). Null: no es de
  // una chica o es un cobro del saldo (se calcula al pagarse, como siempre).
  operatorCommissionBps Int?
  // «Copa con invitación»: la chica invitada y las partes fijadas al cobrar
  // (para ella y para quien cobró). El resto, del local.
  beneficiaryOperatorId String?  @db.Uuid
  beneficiaryCents      Int?
  chargerCents          Int?
  createdAt             DateTime @default(now()) @db.Timestamptz

  venue        Venue                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payment      Payment?             @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  walletCharge WalletChargeRequest? @relation(fields: [walletChargeId], references: [id], onDelete: Cascade)
  serviceItem  ServiceItem?         @relation(fields: [serviceItemId], references: [id], onDelete: SetNull)
  beneficiary  User?                @relation("PaymentLineBeneficiary", fields: [beneficiaryOperatorId], references: [id], onDelete: SetNull)
  earnings     OperatorEarning[]

  @@index([beneficiaryOperatorId])
  @@index([paymentId])
  @@index([walletChargeId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, category])
  @@map("payment_lines")
}

// Contador de la referencia corta (C-0001) de cada local: se suma y se lee en
// la misma transacción que crea el cobro (la fila queda bloqueada hasta el
// commit). FORCE RLS: solo dentro de una transacción de PrismaService.
model ChargeRefCounter {
  tenantId  String   @id @db.Uuid
  lastRef   Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("charge_ref_counters")
}

model PaymentEvent {
  id         BigInt   @id @default(autoincrement())
  paymentId  String   @db.Uuid
  tenantId   String   @db.Uuid
  eventType  String
  payload    Json
  traceId    String
  occurredAt DateTime @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([tenantId, occurredAt(sort: Desc)])
  // Bandeja de incidencias y ajustes del Z, por tipo (20261029400000_indices_informes).
  @@index([tenantId, eventType, occurredAt])
  @@index([traceId])
  @@map("payment_events")
}

// ───────────────────────── Refunds ─────────────────────────────────

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @db.Uuid
  paymentId        String       @db.Uuid
  amountCents      Int
  reason           String?
  requestedBy      String       @db.Uuid
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  // Devolución pedida desde el panel (20261026000000): la clave de la
  // pantalla, la huella de lo pedido (cobro, importe, quién) y la respuesta
  // que se repite al reintentar. Null = sin clave (las de antes, las del banco).
  idempotencyKey    String?
  intentFingerprint String?
  replayResponse    Json?
  // Repaso del descuento a la chica: siguiente intento, intentos y último fallo.
  earningReversalRetryAt   DateTime? @db.Timestamptz
  earningReversalAttempts  Int       @default(0)
  earningReversalLastError String?
  // Fase 1C: hecha en el portal del banco y apuntada a mano en el panel.
  registeredManually Boolean     @default(false)
  bankRefundedAt     DateTime?   @db.Timestamptz
  // La parte de esta devolución que es «Comisión del servicio» (20261030100000):
  // en proporción a lo cobrado, por lo acumulado (sin céntimos sueltos). Se fija
  // al darla por hecha, con el cobro bloqueado. 0 en las recargas y sin comisión.
  serviceFeeCents    Int         @default(0)
  createdAt        DateTime     @default(now()) @db.Timestamptz

  payment   Payment           @relation(fields: [paymentId], references: [id])
  reversals EarningReversal[]

  // CHECK solo en SQL (20261029400100_check_dinero): amountCents > 0.
  @@index([tenantId, paymentId])
  @@unique([tenantId, idempotencyKey])
  @@map("refunds")
}

// ───────────────────────── Operator earnings & payouts ─────────────
// Una fila por payment AUTHORIZED creado por una operadora (chica).
// Snapshot de comisión al momento de autorizar — cambios posteriores de
// commissionBps en User no afectan earnings ya creados.

model OperatorEarning {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  operatorId         String   @db.Uuid
  // Source: exactly ONE of paymentId or consumptionId must be set (CHECK en
  // SQL). Una por cobro (o consumo) y persona (20261023100200): una
  // invitación da ganancia a la chica invitada y, si el local lo pone, al
  // camarero que la cobró.
  paymentId          String?  @db.Uuid
  // Phase 1B — earnings generadas por consumo de wallet ("tiempo" con chica
  // en operator app). Mismo ledger que paymentId, distinto origen.
  consumptionId      String?  @db.Uuid
  // La línea de la invitación de la que sale (null: la comisión de siempre).
  paymentLineId      String?  @db.Uuid
  paymentAmountCents Int
  commissionBps      Int
  // Calculado: round(paymentAmountCents * commissionBps / 10000) — banker-like
  // rounding para evitar bias unidireccional contra operadora.
  commissionCents    Int
  // Propinas asociadas al earning (cliente añadió tip dirigido a esta chica).
  // 100% del tip va a la operadora; no se reduce con BPS.
  tipCents           Int      @default(0)
  // Suma acumulada de descuentos por refunds proporcionales.
  // Saldo neto del earning = commissionCents + tipCents - reversedCents.
  reversedCents      Int      @default(0)
  // Null = pendiente de payout. Set cuando admin marca pagado.
  payoutId           String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz

  venue       Venue              @relation(fields: [tenantId], references: [id])
  operator    User               @relation("OperatorEarnings", fields: [operatorId], references: [id])
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  consumption WalletConsumption? @relation(fields: [consumptionId], references: [id])
  paymentLine PaymentLine?       @relation(fields: [paymentLineId], references: [id], onDelete: SetNull)
  payout      OperatorPayout?    @relation("EarningPayout", fields: [payoutId], references: [id])
  reversals   EarningReversal[]

  // CHECK solo en SQL (20261029400100_check_dinero): commissionCents >= 0 y
  // commissionBps de 0 a 10000 (además de los de tipCents y reversedCents).
  @@unique([paymentId, operatorId])
  @@unique([consumptionId, operatorId])
  @@index([paymentId])
  @@index([consumptionId])
  @@index([tenantId, operatorId, payoutId])
  @@index([tenantId, operatorId, createdAt(sort: Desc)])
  @@map("operator_earnings")
}

// Idempotency log para refund → earning reversal.
// Cada refund SUCCEEDED dispara una fila por ganancia del cobro (única por
// devolución y ganancia). Reintento del processor no duplica el descuento.
model EarningReversal {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  earningId          String   @db.Uuid
  // Origen de la deuda: una devolución del banco o un consumo del saldo anulado.
  refundId           String?  @db.Uuid
  consumptionId      String?  @db.Uuid
  reversedDeltaCents Int
  // true = el earning ya estaba pagado: el descuento es deuda de la chica y
  // se resta del siguiente payout (settledPayoutId = ese payout).
  afterPayout        Boolean  @default(false)
  settledPayoutId    String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz

  earning OperatorEarning @relation(fields: [earningId], references: [id], onDelete: Cascade)
  refund  Refund?         @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@unique([refundId, earningId])
  @@unique([consumptionId, earningId])
  @@index([refundId])
  @@index([consumptionId])
  @@index([earningId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("earning_reversals")
}

// Una fila por liquidación admin → operadora.
// totalCents = SUM(commissionCents - reversedCents) de earnings agrupadas.

model OperatorPayout {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  operatorId   String   @db.Uuid
  totalCents   Int
  paidByUserId String   @db.Uuid
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  // Phase 1A — referencia externa + estado reconciliación
  externalTxId         String?
  externalRail         String?
  reconciliationStatus String   @default("UNRECONCILED")
  receiptUrl           String?
  reconciledAt         DateTime? @db.Timestamptz
  reconciledByUserId   String?  @db.Uuid

  // FX snapshot al momento de crear el payout (para rails cripto). Permite
  // reconciliar con la tasa congelada, no la actual — evita falsos MISMATCH
  // por volatilidad EUR↔USDT entre creación y verificación on-chain.
  expectedAmountUsdt   Decimal? @db.Decimal(20, 6)
  payoutFxRate         Decimal? @db.Decimal(12, 6)

  // Idempotency-Key de «Marcar pagado» (repetirlo sin respuesta no paga dos
  // veces) y la huella de quién y qué pidió: otra petición con la misma, 409.
  idempotencyKey       String?
  idempotencyHash      String?

  // La dirección de cobro que tenía la persona al apuntar el pago
  // (20261029400200): la verificación on-chain compara con esta, no con la de
  // ahora. NULL = pago de antes (se compara con la actual); '' = no tenía.
  paidToAddress        String?

  venue        Venue             @relation(fields: [tenantId], references: [id])
  operator     User              @relation("OperatorPayouts", fields: [operatorId], references: [id])
  paidBy       User              @relation("PayoutsPaid", fields: [paidByUserId], references: [id])
  reconciledBy User?             @relation("PayoutsReconciled", fields: [reconciledByUserId], references: [id])
  earnings     OperatorEarning[] @relation("EarningPayout")

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, operatorId, createdAt(sort: Desc)])
  @@index([tenantId, reconciliationStatus])
  // Solo en SQL (migración 20261015040000): índice único parcial
  // operator_payouts_tenant_onchain_tx_key (tenantId, lower(btrim(externalTxId)))
  // para rails cripto auto-verificables — un hash on-chain, un solo pago.
  @@map("operator_payouts")
}

// ───────────────────────── Webhooks ────────────────────────────────

model WebhookDelivery {
  id              BigInt    @id @default(autoincrement())
  provider        Provider
  externalEventId String
  rawBody         Bytes
  signature       String
  processedAt     DateTime? @db.Timestamptz
  tenantId        String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz

  @@unique([provider, externalEventId])
  @@index([processedAt])
  @@map("webhook_deliveries")
}

// ───────────────────────── Reconciliation ──────────────────────────

enum ReconStatus {
  OK
  MISMATCH
  PARTIAL
}

model Reconciliation {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @db.Uuid
  provider          Provider
  day               DateTime    @db.Date
  localTotalCents   Int
  gatewayTotalCents Int
  diffCents         Int
  status            ReconStatus
  discrepancies     Json?
  runAt             DateTime    @default(now()) @db.Timestamptz

  @@unique([tenantId, provider, day])
  @@index([status])
  @@map("reconciliations")
}

// ───────────────────────── Audit log ────────────────────────────────
// Append-only, no DELETE/UPDATE. Forense de cambios sensibles:
// - login (success/failure)
// - refund (cualquier importe)
// - cambios de role / credenciales / passwords
// - revocacion de JWT
// tenantId puede ser null para acciones globales del owner cross-venue.

model AuditEvent {
  id          BigInt    @id @default(autoincrement())
  tenantId    String?   @db.Uuid
  actorId     String?   @db.Uuid
  actorEmail  String?
  action      String
  targetType  String?
  targetId    String?
  payload     Json?
  ip          String?
  userAgent   String?
  traceId     String?
  occurredAt  DateTime  @default(now()) @db.Timestamptz

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([traceId])
  @@map("audit_events")
}

// ───────────────────────── Phase 1B — Client Wallet ─────────────────
// Closed-loop prepaid wallet (cash-in-advance). Legal vía EMD2 art. 1.5(k):
// el saldo solo se gasta dentro del venue emisor, sin convertirse en cash
// directamente. El cliente carga UNA VEZ (un cargo en su tarjeta con
// descriptor neutro), consume durante la noche en barra/habitaciones/chicas,
// y el saldo no consumido se reembolsa al cierre.

enum WalletStatus {
  ACTIVE
  EXPIRED
  REFUNDED
  DEPLETED
}

model ClientWallet {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @db.Uuid
  // Identificador opcional del cliente (phone, email, NFC tag, anon hash).
  // No es PII obligatoria — el saldo se identifica por qrToken.
  identifier   String?
  balanceCents Int          @default(0)
  status       WalletStatus @default(ACTIVE)
  // Null = no expira mientras ACTIVE (típico durante la noche).
  // Set cuando admin convierte balance restante en CRÉDITO para próxima visita.
  expiresAt    DateTime?    @db.Timestamptz
  // Token único en el QR del cliente. La operadora/camarero/recepción escanean
  // este token para cobrar consumiciones.
  qrToken      String       @unique
  // Saldo NightPay: código que enseña el cliente, grupo de locales y si pidió
  // que le devuelvan el saldo.
  shortCode        String?
  walletGroup      String?
  closeRequestedAt DateTime? @db.Timestamptz
  // Recarga sumada a otro saldo del mismo cliente (con su Face ID).
  mergedIntoId     String?   @db.Uuid
  // PIN del cliente para pagar sin sacar el móvil (HMAC del servidor + scrypt).
  pinHash          String?
  // 5 PIN fallidos seguidos → bloqueado hasta que lo desbloquee el encargado.
  pinFails         Int       @default(0)
  pinLockedAt      DateTime? @db.Timestamptz
  pinFailedAt      DateTime? @db.Timestamptz
  // El encargado que puso el PIN sin el cliente delante: él no cobra con ese PIN.
  pinSetById       String?   @db.Uuid
  // Bloqueado por el super-admin: no paga (sí se le puede devolver). 20261016100100.
  blockedAt        DateTime? @db.Timestamptz
  blockedReason    String?
  // Último PIN bueno: lo gastado con el NFC sin PIN se cuenta desde aquí
  // (o desde las 08:00 de Madrid, lo más tarde). 20261023200000.
  noPinResetAt     DateTime? @db.Timestamptz
  // Recarga cobrada sin leer antes el NFC del cliente: espera a sumarse a su
  // saldo (al acercar su NFC o teclear su código). Quién la cobró.
  pendingAssignAt   DateTime? @db.Timestamptz
  pendingAssignById String?   @db.Uuid
  // Teléfono opcional al darle una ficha nueva (20261110100000): solo para
  // encontrar su saldo si lo pierde todo. Dato personal: fuera de las listas;
  // lo ven el encargado y el dueño en el detalle. Normalizado (CHECK en SQL).
  contactPhone      String?   @db.VarChar(16)
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  venue          Venue                 @relation(fields: [tenantId], references: [id])
  topUps         Payment[]
  consumptions   WalletConsumption[]
  chargeRequests WalletChargeRequest[]
  payouts        WalletPayout[]
  cashTopUps     WalletCashTopUp[]
  passkeys       WalletPasskey[]
  cards          WalletCard[]
  passes         WalletPass[]
  activationTokens WalletActivationToken[]
  pushSubscriptions WalletPushSubscription[]

  @@index([tenantId, status])
  @@index([tenantId, identifier])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([mergedIntoId])
  @@map("client_wallets")
}

/// Ficha NFC del saldo: lleva grabado un enlace con `token` (?ficha=...).
/// Dice de qué saldo es; para pagar, el cliente pone su PIN.
/// Sin tenantId ni RLS a propósito: se graba en blanco y se da a un saldo de
/// cualquier local del grupo. El acceso va siempre por el saldo (la API
/// comprueba sameWalletGroup con el local de quien la usa; WalletChargesService).
/// `venueId` dice dónde está la ficha (su stock o el local que la dio), sin RLS:
/// el panel lista las fichas de su local con él (20261021100000).
model WalletCard {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token      String    @unique
  /// Número de serie (si se leyó con un Android): una copia no vale.
  uid        String?
  /// «Ficha nº 0522»: el número de la ficha para siempre, uno para todos los
  /// locales (secuencia; las antiguas, por orden de alta). 20261024200000.
  number     Int       @unique @default(autoincrement())
  /// Número impreso de fábrica, tal cual se teclea (con sus ceros): «Ficha nº 00736903».
  printedNumber String? @db.VarChar(12)
  /// El mismo sin ceros delante («736903»): para buscar y para que no se repita
  /// (20261027100000). Null sin número, o si chocó con otro al migrar (renumerar en el panel).
  printedNumberNorm String? @db.VarChar(12)
  /// Dónde no se repite, fijado al numerarla: «g:<grupo de locales>» o «v:<local>»
  /// (las fichas pasan de un local a otro del grupo; las de otro grupo o local, aparte).
  printedScope String?
  walletId   String?   @db.Uuid
  /// STOCK (grabada, sin dar) → ISSUED (dada a un saldo) → RETURNED (devuelta,
  /// otra vez en el stock) | LOST (perdida o sustituida) | BLOCKED (bloqueada).
  /// Solo ISSUED paga. ACTIVE = la del API anterior (paso 1 de 2 de
  /// 20261021100000): con saldo vale como ISSUED, sin saldo como STOCK. Por eso
  /// la base sigue con ACTIVE por defecto; el código pasa siempre el estado.
  status     String    @default("ACTIVE")
  /// Local donde está: el de su stock o el que la dio.
  venueId    String?   @db.Uuid
  linkedById String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  /// Grabada y apuntada en el stock (null: código pedido y aún sin grabar).
  stockedAt  DateTime? @db.Timestamptz
  /// Cuándo se dio a su saldo (ISSUED).
  linkedAt   DateTime? @db.Timestamptz
  returnedAt DateTime? @db.Timestamptz
  lostAt     DateTime? @db.Timestamptz
  blockedAt  DateTime? @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz

  wallet ClientWallet?      @relation(fields: [walletId], references: [id], onDelete: SetNull)
  venue  Venue?             @relation(fields: [venueId], references: [id], onDelete: SetNull)
  events WalletCardEvent[]

  @@unique([printedScope, printedNumberNorm])
  @@index([walletId])
  @@index([venueId, status])
  @@map("wallet_cards")
}

/// Lo que pasa con una ficha (20261021200000): dada (ISSUED), devuelta al stock
/// (RETURNED), perdida o sustituida (LOST), bloqueada (BLOCKED), con el local
/// de ese momento. Los contadores de la noche cuentan eventos. Sin RLS, como
/// wallet_cards: el local va siempre explícito.
model WalletCardEvent {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cardId     String   @db.Uuid
  venueId    String?  @db.Uuid
  walletId   String?  @db.Uuid
  kind       String
  byUserId   String?  @db.Uuid
  terminalId String?  @db.Uuid
  at         DateTime @default(now()) @db.Timestamptz

  card  WalletCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  venue Venue?     @relation(fields: [venueId], references: [id], onDelete: SetNull)

  @@index([venueId, at])
  @@index([cardId])
  @@map("wallet_card_events")
}

/// QR de activación de un solo uso (20261102200000_activacion_un_uso, M-2): lo
/// enseña recepción tras una recarga en efectivo (o el dueño al dar un enlace
/// nuevo) para que el cliente active en SU móvil el primer Face ID o el primer
/// PIN, sin enseñar nunca el enlace permanente del saldo (/w/<qrToken>). El
/// enlace es /w/a/<token>; aquí solo su sha256 (el token no se guarda). Vale
/// 10 min y una sola vez: el primer Face ID o PIN registrado con él lo gasta
/// (usedAt) en la misma transacción. Emitir otro para el saldo anula los
/// anteriores sin usar (revokedAt). Sin tenantId ni RLS, como wallet_passkeys:
/// cuelga del saldo y se busca siempre por su hash o por el saldo.
model WalletActivationToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId   String    @db.Uuid
  /// sha256 (hex) del token de /w/a/<token>.
  tokenHash  String    @unique
  /// Local donde se emitió (el de recepción, o el del saldo con un enlace nuevo).
  venueId    String?   @db.Uuid
  /// Quién lo emitió (recepción, encargado, dueño o super-admin).
  issuedById String?   @db.Uuid
  /// reception (QR de «Cargado») | relink (enlace nuevo del dueño o del super-admin).
  via        String
  createdAt  DateTime  @default(now()) @db.Timestamptz
  expiresAt  DateTime  @db.Timestamptz
  /// Gastado con el primer Face ID o PIN (usedFor: passkey | pin).
  usedAt     DateTime? @db.Timestamptz
  usedFor    String?
  /// Anulado sin usar: se emitió otro para el mismo saldo.
  revokedAt  DateTime? @db.Timestamptz

  wallet ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_activation_tokens")
}

/// Llave del cliente para pagar con su saldo desbloqueando su móvil (Face ID,
/// huella o el PIN del teléfono). Solo la clave pública.
model WalletPasskey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId     String    @db.Uuid
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  createdAt    DateTime  @default(now()) @db.Timestamptz
  lastUsedAt   DateTime? @db.Timestamptz

  wallet ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_passkeys")
}

/// Llave de acceso del personal (20261109100000, «Detalle del pago»): quien no
/// tiene 2FA se verifica con ella (Face ID, huella o el PIN de su móvil) para
/// ver lo delicado de un cobro y para las acciones que piden 2FA. Solo la
/// clave pública. Sin local ni RLS, como wallet_passkeys: cuelga de la persona.
model StaffPasskey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @db.Uuid
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  /// El móvil con el que se dio de alta («iPhone · iOS 18»).
  name         String
  createdAt    DateTime  @default(now()) @db.Timestamptz
  lastUsedAt   DateTime? @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("staff_passkeys")
}

/// Dónde está guardado el pase del saldo (hoy solo Google Wallet; Apple, más adelante).
enum WalletPassProvider {
  GOOGLE
}

/// Pase del saldo guardado en el móvil del cliente (Google Wallet). Un repaso
/// cada ~2 min lo pone al día cuando el saldo o su estado cambian.
/// Sin tenantId ni RLS a propósito, como wallet_passkeys y wallet_cards: el
/// saldo vale en todo el grupo y el acceso va siempre por el saldo (el enlace
/// /w del cliente o el repaso del sistema, que lee client_wallets con asSystem).
/// No guarda el enlace: solo su hash (tokenHash) y el id del pase en Google,
/// que también sale de ese hash.
model WalletPass {
  id                     String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId               String             @db.Uuid
  provider               WalletPassProvider @default(GOOGLE)
  /// Id del pase en Google: <emisor>.<clase>-<hash del enlace>.
  objectId               String             @unique
  /// sha256 del enlace del saldo cuando se hizo el pase: si el dueño da un
  /// enlace nuevo, el pase viejo se apaga (revokedAt).
  tokenHash              String
  lastSyncedBalanceCents Int
  lastSyncedStatus       WalletStatus
  lastSyncedAt           DateTime           @default(now()) @db.Timestamptz
  /// Último intento del repaso (bien o mal): los que fallan pasan al final de
  /// la cola y no tapan a los demás.
  lastAttemptAt          DateTime?          @db.Timestamptz
  revokedAt              DateTime?          @db.Timestamptz
  createdAt              DateTime           @default(now()) @db.Timestamptz

  wallet ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_passes")
}

// Cada consumo del balance de una wallet. Atómicamente:
//  1. balance -= amountCents (SELECT FOR UPDATE de ClientWallet)
//  2. crea WalletConsumption
//  3. si providedByUser.role = OPERATOR, crea OperatorEarning ligado
// Rollback: si admin cancela un consumo, sumamos reversedAt y devolvemos
// el importe al balance.

model WalletConsumption {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  walletId         String   @db.Uuid
  amountCents      Int
  providedByUserId String   @db.Uuid
  // Categoría libre: "bar" | "room" | "time" | "service" | "other"
  // No es enum porque el venue puede tener categorías propias.
  category         String
  notes            String?
  // Idempotency key para evitar doble-cobro (camarero pulsa 2 veces).
  idempotencyKey   String?
  // Propina opcional dentro del consumo. 100% va a providedBy si es OPERATOR
  // (o según tipGoesTo si se especifica).
  tipCents         Int       @default(0)
  tipGoesTo        String?
  reversedAt       DateTime? @db.Timestamptz
  reversedByUserId String?   @db.Uuid
  // Cómo se autorizó: nfc_nopin | pin | passkey | staff (null: de antes). 20261023200000.
  authMethod       String?
  // El % antiguo de OxioPay sobre este consumo (20261030100000): null = el del
  // local, como siempre. (La primera versión de la «Comisión del servicio»
  // ponía 0 con el interruptor encendido; ya no se escribe.)
  platformCommissionBps Int?
  // La parte del importe (sin propina) pagada con saldo cargado CON «Comisión
  // del servicio» (20261030110000; wallet-fee-saldo.ts): el % antiguo va
  // solo sobre el resto. 0 = todo del saldo sin ella (o de antes).
  serviceFeeSaldoCents Int   @default(0)
  createdAt        DateTime  @default(now()) @db.Timestamptz

  venue       Venue            @relation(fields: [tenantId], references: [id])
  wallet      ClientWallet     @relation(fields: [walletId], references: [id])
  providedBy  User             @relation("ConsumptionProvider", fields: [providedByUserId], references: [id])
  reversedBy  User?            @relation("ConsumptionReversedBy", fields: [reversedByUserId], references: [id])
  earnings    OperatorEarning[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, walletId, createdAt(sort: Desc)])
  @@index([tenantId, providedByUserId, createdAt(sort: Desc)])
  @@index([tenantId, category])
  @@index([walletId, createdAt])
  // Consumos del Z y de los informes por fecha (20261029400000_indices_informes).
  @@index([tenantId, createdAt])
  @@map("wallet_consumptions")
}

// ─── Cuadre con el banco (2026-10-14) ────────────────────────────────────
// Fichero de operaciones del portal de BBVA/Redsys o de Paytef comparado
// línea a línea con lo apuntado. tenantId = local desde el que se sube.
model BankStatement {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  // REDSYS | PAYTEF
  source           String
  fileName         String
  fileSha256       String
  periodFrom       DateTime  @db.Date
  periodTo         DateTime  @db.Date
  rowsTotal        Int
  skippedCount     Int       @default(0)
  otherCount       Int       @default(0)
  matchedCount     Int
  problemCount     Int
  bankTotalCents   Int
  oursTotalCents   Int
  uploadedByUserId String    @db.Uuid
  supersededAt     DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz

  items BankStatementItem[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("bank_statements")
}

// Una línea del cuadre. tenantId = local al que se atribuye.
model BankStatementItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementId     String    @db.Uuid
  tenantId        String    @db.Uuid
  status          String
  // SALE | REFUND
  kind            String
  line            Int?
  occurredAt      DateTime? @db.Timestamptz
  bankAmountCents Int?
  oursAmountCents Int?
  reference       String?
  terminal        String?
  authCode        String?
  paymentId       String?   @db.Uuid
  refundId        String?   @db.Uuid
  supersededAt    DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([tenantId, status])
  // Comisión retenida de las ventas por datáfono (20261102090000): «¿este cobro
  // ya casa con el banco?» se pregunta por cobro en cada saldo y cada pago.
  @@index([paymentId])
  @@map("bank_statement_items")
}

// ───────────────────────── Liquidación OxioPay ──────────────────────
// (20261031100000) Lo que cada local debe a OxioPay por semana (lunes 08:00 →
// lunes 08:00 de Madrid): lo que el mapa del dinero pone como de OxioPay en esa
// ventana (comisión del servicio cobrada − devuelta + comisión de plataforma
// donde no la hay). Se genera el lunes por la mañana y se congela (como el Z):
// lo apuntado tarde con fecha de una semana ya liquidada va a la siguiente
// como «ajustes de semanas anteriores» (desglose en `breakdown`). Una activa
// (no anulada) por local y semana (índice parcial en SQL). El local la paga por
// transferencia con su referencia; el super-admin apunta los pagos (2FA).
// FORCE RLS (apps/api/src/common/prisma/rls.ts). CHECK de importes y estados en SQL.

enum OxioPaySettlementStatus {
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
}

model OxioPaySettlement {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String                  @db.Uuid
  // El negocio del local al emitirla (para filtrar en la consola).
  businessId       String?                 @db.Uuid
  periodFrom       DateTime                @db.Timestamptz
  periodTo         DateTime                @db.Timestamptz
  isoYear          Int
  isoWeek          Int
  // OXP-2026-S44-<SLUG> (con /R2, /R3… si se regenera tras anularla): la de la transferencia.
  reference        String                  @unique
  status           OxioPaySettlementStatus @default(ISSUED)
  // Lo de la semana (las 7 noches) y lo de semanas anteriores apuntado tarde.
  periodCents      Int
  adjustmentsCents Int                     @default(0)
  totalCents       Int
  paidCents        Int                     @default(0)
  // Lo que daba el mapa del dinero para esa ventana al emitirla (comprobación).
  moneyMapCents    Int
  // Desglose congelado: noches × conceptos, ajustes, local y negocio, % de plataforma usado.
  breakdown        Json
  // La generó el repaso del lunes (false: el super-admin a mano, con 2FA).
  auto             Boolean                 @default(true)
  generatedAt      DateTime                @default(now()) @db.Timestamptz
  generatedById    String?                 @db.Uuid
  // La anulada a la que sustituye (regenerada).
  replacesId       String?                 @db.Uuid
  paidAt           DateTime?               @db.Timestamptz
  voidedAt         DateTime?               @db.Timestamptz
  voidedById       String?                 @db.Uuid
  voidReason       String?
  updatedAt        DateTime                @default(now()) @updatedAt @db.Timestamptz

  venue    Venue                      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  business Business?                  @relation(fields: [businessId], references: [id], onDelete: SetNull)
  payments OxioPaySettlementPayment[]

  @@unique([id, tenantId])
  @@index([tenantId, periodFrom(sort: Desc)])
  @@index([status, generatedAt])
  @@index([businessId])
  @@map("oxiopay_settlements")
}

// Un pago apuntado (transferencia recibida). Solo de añadir (trigger en SQL).
model OxioPaySettlementPayment {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  settlementId  String   @db.Uuid
  amountCents   Int
  // Día del abono en el banco.
  paidOn        DateTime @db.Date
  bankReference String
  // Obligatorio si el importe no era lo pendiente (lo comprueba el API).
  reason        String?
  recordedById  String   @db.Uuid
  recordedAt    DateTime @default(now()) @db.Timestamptz

  // Con el local: un pago nunca apunta a la liquidación de otro local.
  settlement OxioPaySettlement @relation(fields: [settlementId, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([settlementId])
  @@index([tenantId])
  @@map("oxiopay_settlement_payments")
}

// Cuenta de OxioPay para las transferencias (una sola fila, id = 1). Global:
// solo con bypass (como businesses). La cambia el super-admin con 2FA.
model OxioPayPayee {
  id          Int      @id @default(1) @db.SmallInt
  name        String
  // Sin espacios y en mayúsculas, mod-97 (el API).
  iban        String
  holder      String
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz
  updatedById String?  @db.Uuid

  @@map("oxiopay_payee")
}

// Semana de inicio de las liquidaciones (20261031110000): un lunes, una fila
// (id = 1). Nada anterior se liquida, se ajusta ni se genera a mano. Vacía, el
// API la fija al arrancar con el próximo lunes. Global: solo con bypass.
model OxioPaySettlementSettings {
  id          Int      @id @default(1) @db.SmallInt
  startWeek   DateTime @db.Date
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz
  updatedById String?  @db.Uuid

  @@map("oxiopay_settlement_settings")
}
