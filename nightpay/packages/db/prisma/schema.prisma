// NightPay — schema Prisma v1 (Sprint 1)
// Docs: ver nightpay/docs/MASTER_PLAN_V2.md §5

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  // native = local dev (Windows/Mac/Linux); linux-musl-openssl-3.0.x = Alpine en Docker
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Tenants & Users ─────────────────────────

model Venue {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String    @unique
  timezone              String    @default("Europe/Madrid")
  // Tope de importe para cobros creados por OPERATOR (default 200€).
  // OWNER/MANAGER ignoran este cap. El cap global de 10.000€ del Zod schema sigue.
  operatorMaxCobroCents Int       @default(20000)
  // Comisión NightPay en basis points (default 1000 = 10%).
  // Modelo: chica recibe su commissionBps; plataforma recibe platformCommissionBps.
  platformCommissionBps Int       @default(1000)
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz
  deletedAt             DateTime? @db.Timestamptz

  users              User[]
  terminals          Terminal[]
  gatewayCredentials GatewayCredential[]
  payments           Payment[]
  operatorEarnings   OperatorEarning[]
  operatorPayouts    OperatorPayout[]
  clientWallets      ClientWallet[]
  walletConsumptions WalletConsumption[]

  @@map("venues")
}

enum Role {
  OWNER
  MANAGER
  WAITER
  OPERATOR
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  email        String    @unique
  passwordHash String
  role         Role
  totpSecret   String?
  // Solo aplica cuando role = OPERATOR. 1500 bps = 15.00%
  commissionBps Int?
  // Nombre visible para admin (ej. "Ana", "Marina"). Solo OPERATOR.
  displayName  String?
  // Marca de invitacion pendiente — null cuando ya activo password.
  invitedAt    DateTime?
  // JWT de un solo uso para set-password. Limpio al aceptar la invitacion.
  inviteToken  String?   @unique
  // sha256 hash del JWT self-onboarding (TTL 72h). Admin genera el link para
  // que la chica rellene su perfil ella sola si sabe manejar la web + KYC.
  selfOnboardingToken String? @unique
  // Phase 1A — routing de payout. Solo OPERATOR. Valores en migration 20260511 comment.
  // Si payoutMethod es null el modal "Marcar pagado" cae a MANUAL_CASH.
  payoutMethod   String?
  payoutAddress  String?
  payoutMetadata Json?
  payoutLabel    String?
  // Phase 1A.1 — onboarding tracking (solo OPERATOR)
  phone               String?
  passportCountry     String?
  passportLast4       String?
  hasEmpadronamiento  Boolean @default(false)
  hasNie              Boolean @default(false)
  hasTie              Boolean @default(false)
  walletProvider      String?
  walletStatus        String?
  walletTestPassed    Boolean @default(false)
  walletTestAt        DateTime? @db.Timestamptz
  needsHelpWallet     Boolean @default(false)
  needsHelpDocs       Boolean @default(false)
  onboardingStatus    String  @default("NEW")
  onboardingNotes     String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  deletedAt    DateTime? @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id])

  // Relaciones para OPERATOR
  earnings              OperatorEarning[]   @relation("OperatorEarnings")
  payouts               OperatorPayout[]    @relation("OperatorPayouts")
  payoutsPaid           OperatorPayout[]    @relation("PayoutsPaid")
  payoutsReconciled     OperatorPayout[]    @relation("PayoutsReconciled")
  paymentsCreated       Payment[]           @relation("PaymentCreatedBy")
  // Phase 1B — wallet consumptions cobrados por este usuario
  providedConsumptions  WalletConsumption[] @relation("ConsumptionProvider")
  reversedConsumptions  WalletConsumption[] @relation("ConsumptionReversedBy")

  @@index([tenantId])
  @@map("users")
}

model Terminal {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @db.Uuid
  externalId String
  label      String
  active     Boolean @default(true)

  venue    Venue     @relation(fields: [tenantId], references: [id])
  payments Payment[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@map("terminals")
}

// ───────────────────────── Gateway credentials ─────────────────────

enum Provider {
  WIPAY
  PEANPE
}

model GatewayCredential {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  provider   Provider
  // Credenciales cifradas AES-256-GCM
  encKey     Bytes
  encNonce   Bytes
  encTag     Bytes
  kekVersion Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, active])
  @@map("gateway_credentials")
}

// ───────────────────────── Payments ────────────────────────────────

enum PaymentStatus {
  CREATED
  AWAITING_CAPTURE
  AUTHORIZING
  AUTHORIZED
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  ORPHAN
  CANCELED
}

model Payment {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String        @db.Uuid
  terminalId           String        @db.Uuid
  // Set por payments.service cuando hay request context con userId.
  // null cuando origen no humano (cron, webhook reconcile, etc.).
  createdByUserId      String?       @db.Uuid
  idempotencyKey       String
  amountCents          Int
  currency             String        @default("EUR") @db.Char(3)
  status               PaymentStatus @default(CREATED)
  provider             Provider?
  providerTxId         String?
  qrToken              String        @unique
  qrExpiresAt          DateTime      @db.Timestamptz
  availableAmountCents Int
  createdAt            DateTime      @default(now()) @db.Timestamptz
  updatedAt            DateTime      @updatedAt @db.Timestamptz

  // Modo de cobro usado: "QR" | "WALLET_TOPUP". Null para payments antiguos (asume QR).
  captureMethod String?

  // Phase 1B — si este Payment es el top-up de un ClientWallet, walletId apunta
  // a la wallet creada/recargada. Cuando Payment llega a AUTHORIZED, el balance
  // de la wallet se suma atómicamente.
  walletId String? @db.Uuid

  venue           Venue            @relation(fields: [tenantId], references: [id])
  terminal        Terminal         @relation(fields: [terminalId], references: [id])
  createdBy       User?            @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  wallet          ClientWallet?    @relation(fields: [walletId], references: [id])
  events          PaymentEvent[]
  refunds         Refund[]
  operatorEarning OperatorEarning?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, createdByUserId, createdAt(sort: Desc)])
  @@index([providerTxId])
  @@index([qrExpiresAt])
  @@index([walletId])
  @@map("payments")
}

model PaymentEvent {
  id         BigInt   @id @default(autoincrement())
  paymentId  String   @db.Uuid
  tenantId   String   @db.Uuid
  eventType  String
  payload    Json
  traceId    String
  occurredAt DateTime @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([traceId])
  @@map("payment_events")
}

// ───────────────────────── Refunds ─────────────────────────────────

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @db.Uuid
  paymentId        String       @db.Uuid
  amountCents      Int
  reason           String?
  requestedBy      String       @db.Uuid
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  createdAt        DateTime     @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([tenantId, paymentId])
  @@map("refunds")
}

// ───────────────────────── Operator earnings & payouts ─────────────
// Una fila por payment AUTHORIZED creado por una operadora (chica).
// Snapshot de comisión al momento de autorizar — cambios posteriores de
// commissionBps en User no afectan earnings ya creados.

model OperatorEarning {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  operatorId         String   @db.Uuid
  // Source: exactly ONE of paymentId or consumptionId must be set.
  // (DB CHECK constraint en migración + ambos @unique para evitar doble-pago).
  paymentId          String?  @unique @db.Uuid
  // Phase 1B — earnings generadas por consumo de wallet ("tiempo" con chica
  // en operator app). Mismo ledger que paymentId, distinto origen.
  consumptionId      String?  @unique @db.Uuid
  paymentAmountCents Int
  commissionBps      Int
  // Calculado: floor(paymentAmountCents * commissionBps / 10000)
  commissionCents    Int
  // Suma acumulada de descuentos por refunds proporcionales.
  // Saldo neto del earning = commissionCents - reversedCents (puede ser <0).
  reversedCents      Int      @default(0)
  // Null = pendiente de payout. Set cuando admin marca pagado.
  payoutId           String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz

  venue       Venue              @relation(fields: [tenantId], references: [id])
  operator    User               @relation("OperatorEarnings", fields: [operatorId], references: [id])
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  consumption WalletConsumption? @relation(fields: [consumptionId], references: [id])
  payout      OperatorPayout?    @relation("EarningPayout", fields: [payoutId], references: [id])

  @@index([tenantId, operatorId, payoutId])
  @@index([tenantId, operatorId, createdAt(sort: Desc)])
  @@map("operator_earnings")
}

// Una fila por liquidación admin → operadora.
// totalCents = SUM(commissionCents - reversedCents) de earnings agrupadas.

model OperatorPayout {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  operatorId   String   @db.Uuid
  totalCents   Int
  paidByUserId String   @db.Uuid
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  // Phase 1A — referencia externa + estado reconciliación
  externalTxId         String?
  externalRail         String?
  reconciliationStatus String   @default("UNRECONCILED")
  receiptUrl           String?
  reconciledAt         DateTime? @db.Timestamptz
  reconciledByUserId   String?  @db.Uuid

  venue        Venue             @relation(fields: [tenantId], references: [id])
  operator     User              @relation("OperatorPayouts", fields: [operatorId], references: [id])
  paidBy       User              @relation("PayoutsPaid", fields: [paidByUserId], references: [id])
  reconciledBy User?             @relation("PayoutsReconciled", fields: [reconciledByUserId], references: [id])
  earnings     OperatorEarning[] @relation("EarningPayout")

  @@index([tenantId, operatorId, createdAt(sort: Desc)])
  @@index([tenantId, reconciliationStatus])
  @@map("operator_payouts")
}

// ───────────────────────── Webhooks ────────────────────────────────

model WebhookDelivery {
  id              BigInt    @id @default(autoincrement())
  provider        Provider
  externalEventId String
  rawBody         Bytes
  signature       String
  processedAt     DateTime? @db.Timestamptz
  tenantId        String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz

  @@unique([provider, externalEventId])
  @@index([processedAt])
  @@map("webhook_deliveries")
}

// ───────────────────────── Reconciliation ──────────────────────────

enum ReconStatus {
  OK
  MISMATCH
  PARTIAL
}

model Reconciliation {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @db.Uuid
  provider          Provider
  day               DateTime    @db.Date
  localTotalCents   Int
  gatewayTotalCents Int
  diffCents         Int
  status            ReconStatus
  discrepancies     Json?
  runAt             DateTime    @default(now()) @db.Timestamptz

  @@unique([tenantId, provider, day])
  @@index([status])
  @@map("reconciliations")
}

// ───────────────────────── Audit log ────────────────────────────────
// Append-only, no DELETE/UPDATE. Forense de cambios sensibles:
// - login (success/failure)
// - refund (cualquier importe)
// - cambios de role / credenciales / passwords
// - revocacion de JWT
// tenantId puede ser null para acciones globales del owner cross-venue.

model AuditEvent {
  id          BigInt    @id @default(autoincrement())
  tenantId    String?   @db.Uuid
  actorId     String?   @db.Uuid
  actorEmail  String?
  action      String
  targetType  String?
  targetId    String?
  payload     Json?
  ip          String?
  userAgent   String?
  traceId     String?
  occurredAt  DateTime  @default(now()) @db.Timestamptz

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([traceId])
  @@map("audit_events")
}

// ───────────────────────── Phase 1B — Client Wallet ─────────────────
// Closed-loop prepaid wallet (cash-in-advance). Legal vía EMD2 art. 1.5(k):
// el saldo solo se gasta dentro del venue emisor, sin convertirse en cash
// directamente. El cliente carga UNA VEZ (un cargo en su tarjeta con
// descriptor neutro), consume durante la noche en barra/habitaciones/chicas,
// y el saldo no consumido se reembolsa al cierre.

enum WalletStatus {
  ACTIVE
  EXPIRED
  REFUNDED
  DEPLETED
}

model ClientWallet {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @db.Uuid
  // Identificador opcional del cliente (phone, email, NFC tag, anon hash).
  // No es PII obligatoria — el saldo se identifica por qrToken.
  identifier   String?
  balanceCents Int          @default(0)
  status       WalletStatus @default(ACTIVE)
  // Null = no expira mientras ACTIVE (típico durante la noche).
  // Set cuando admin convierte balance restante en CRÉDITO para próxima visita.
  expiresAt    DateTime?    @db.Timestamptz
  // Token único en el QR del cliente. La operadora/camarero/recepción escanean
  // este token para cobrar consumiciones.
  qrToken      String       @unique
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  venue        Venue               @relation(fields: [tenantId], references: [id])
  topUps       Payment[]
  consumptions WalletConsumption[]

  @@index([tenantId, status])
  @@index([tenantId, identifier])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("client_wallets")
}

// Cada consumo del balance de una wallet. Atómicamente:
//  1. balance -= amountCents (SELECT FOR UPDATE de ClientWallet)
//  2. crea WalletConsumption
//  3. si providedByUser.role = OPERATOR, crea OperatorEarning ligado
// Rollback: si admin cancela un consumo, sumamos reversedAt y devolvemos
// el importe al balance.

model WalletConsumption {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  walletId         String   @db.Uuid
  amountCents      Int
  providedByUserId String   @db.Uuid
  // Categoría libre: "bar" | "room" | "time" | "service" | "other"
  // No es enum porque el venue puede tener categorías propias.
  category         String
  notes            String?
  // Idempotency key para evitar doble-cobro (camarero pulsa 2 veces).
  idempotencyKey   String?
  reversedAt       DateTime? @db.Timestamptz
  reversedByUserId String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz

  venue       Venue            @relation(fields: [tenantId], references: [id])
  wallet      ClientWallet     @relation(fields: [walletId], references: [id])
  providedBy  User             @relation("ConsumptionProvider", fields: [providedByUserId], references: [id])
  reversedBy  User?            @relation("ConsumptionReversedBy", fields: [reversedByUserId], references: [id])
  earning     OperatorEarning?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, walletId, createdAt(sort: Desc)])
  @@index([tenantId, providedByUserId, createdAt(sort: Desc)])
  @@index([tenantId, category])
  @@map("wallet_consumptions")
}
