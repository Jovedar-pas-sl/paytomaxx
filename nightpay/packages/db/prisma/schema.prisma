// NightPay — schema Prisma v1 (Sprint 1)
// Docs: ver nightpay/docs/MASTER_PLAN_V2.md §5

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  // native = local dev (Windows/Mac/Linux); linux-musl-openssl-3.0.x = Alpine en Docker
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Tenants & Users ─────────────────────────

model Venue {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                  String
  slug                  String    @unique
  timezone              String    @default("Europe/Madrid")
  // Tope de importe para cobros creados por OPERATOR (default 200€).
  // OWNER/MANAGER ignoran este cap. El cap global de 10.000€ del Zod schema sigue.
  operatorMaxCobroCents Int       @default(20000)
  // Comisión NightPay en basis points (default 1000 = 10%).
  // Modelo: chica recibe su commissionBps; plataforma recibe platformCommissionBps.
  platformCommissionBps Int       @default(1000)
  // Comisiones por defecto al operator/staff que crea el cobro, por categoría de ingreso.
  // Shape: { CHICA_SERVICE: 9000, VENUE_BAR: 0, VENUE_ROOM: 0, VENUE_FOOD: 0, EXTRA: 0 }
  // Override por chica: User.commissionBps aplica SOLO a CHICA_SERVICE.
  // Las categorías VENUE_* siempre usan el default del venue (es ingreso del local).
  operatorCommissionDefaults Json  @default("{\"CHICA_SERVICE\":9000,\"VENUE_BAR\":0,\"VENUE_ROOM\":0,\"VENUE_FOOD\":0,\"EXTRA\":0}")
  // IVA aplicado a la base imponible (basis points). Default 2100 = 21% (general).
  // Hostelería: 10% (1000) bebidas y comida + 21% (2100) bebidas alcohólicas.
  // Para simplificar Phase 1: un único tipo por venue (admin elige el dominante).
  // Modelo 303 trimestral usa este valor.
  vatBps                Int       @default(2100)
  // Régimen IVA: GENERAL, RECARGO_EQUIVALENCIA (típico hostelería pequeña),
  // EXENTO (no aplica IVA — actividades no sujetas). Default GENERAL.
  vatRegime             String    @default("GENERAL")
  // Saldo NightPay: locales del mismo grupo (mismo dueño) comparten el saldo del cliente.
  walletGroup           String?
  createdAt             DateTime  @default(now()) @db.Timestamptz
  updatedAt             DateTime  @updatedAt @db.Timestamptz
  deletedAt             DateTime? @db.Timestamptz

  users              User[]
  terminals          Terminal[]
  gatewayCredentials GatewayCredential[]
  payments           Payment[]
  operatorEarnings   OperatorEarning[]
  operatorPayouts    OperatorPayout[]
  clientWallets      ClientWallet[]
  walletConsumptions WalletConsumption[]
  peanpeCalls        PeanpeCall[]
  serviceItems       ServiceItem[]
  nights             VenueNight[]
  incidentAcks       IncidentAck[]
  posTerminalOps     PosTerminalOp[]

  @@map("venues")
}

enum Role {
  OWNER
  MANAGER
  WAITER
  OPERATOR
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  email        String    @unique
  passwordHash String
  role         Role
  totpSecret   String?
  // Solo aplica cuando role = OPERATOR. 1500 bps = 15.00%
  commissionBps Int?
  // Super admin "extra-tenant": puede listar/crear todos los locales y switchear
  // su JWT entre venues. tenantId del User sigue apuntando a su venue primario.
  // El flag se setea via CLI (pnpm cli set-super-admin --email X). NO via UI.
  isSuperAdmin  Boolean   @default(false)
  // Nombre visible para admin (ej. "Ana", "Marina"). Solo OPERATOR.
  displayName  String?
  // Marca de invitacion pendiente — null cuando ya activo password.
  invitedAt    DateTime?
  // JWT de un solo uso para set-password. Limpio al aceptar la invitacion.
  inviteToken  String?   @unique
  // sha256 hash del JWT self-onboarding (TTL 72h). Admin genera el link para
  // que la chica rellene su perfil ella sola si sabe manejar la web + KYC.
  selfOnboardingToken String? @unique
  // Phase 1A — routing de payout. Solo OPERATOR. Valores en migration 20260511 comment.
  // Si payoutMethod es null el modal "Marcar pagado" cae a MANUAL_CASH.
  payoutMethod   String?
  payoutAddress  String?
  payoutMetadata Json?
  payoutLabel    String?
  // Tip beneficiary relation (cliente añade propina dirigida a esta operadora/staff)
  tipsReceived        Payment[]           @relation("PaymentTipBeneficiary")

  // Phase 1A.1 — onboarding tracking (solo OPERATOR)
  phone               String?
  passportCountry     String?
  passportLast4       String?
  hasEmpadronamiento  Boolean @default(false)
  hasNie              Boolean @default(false)
  hasTie              Boolean @default(false)
  walletProvider      String?
  walletStatus        String?
  walletTestPassed    Boolean @default(false)
  walletTestAt        DateTime? @db.Timestamptz
  needsHelpWallet     Boolean @default(false)
  needsHelpDocs       Boolean @default(false)
  onboardingStatus    String  @default("NEW")
  onboardingNotes     String?
  createdAt    DateTime  @default(now()) @db.Timestamptz
  updatedAt    DateTime  @updatedAt @db.Timestamptz
  deletedAt    DateTime? @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id])

  // Relaciones para OPERATOR
  earnings              OperatorEarning[]   @relation("OperatorEarnings")
  payouts               OperatorPayout[]    @relation("OperatorPayouts")
  payoutsPaid           OperatorPayout[]    @relation("PayoutsPaid")
  payoutsReconciled     OperatorPayout[]    @relation("PayoutsReconciled")
  paymentsCreated       Payment[]           @relation("PaymentCreatedBy")
  // Phase 1B — wallet consumptions cobrados por este usuario
  providedConsumptions  WalletConsumption[] @relation("ConsumptionProvider")
  reversedConsumptions  WalletConsumption[] @relation("ConsumptionReversedBy")

  @@index([tenantId])
  @@map("users")
}

model Terminal {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String  @db.Uuid
  externalId String
  label      String
  active     Boolean @default(true)

  // Track A — agrupador físico para routing en venues con 6-8 PAX.
  //   - Valores enum: BARRA, HABITACIONES, MESAS, OTRO (validados en app, no DB).
  //   - "OTRO/<custom>" permitido cuando admin necesita zona personalizada.
  //   - NULL = terminal legacy sin zona asignada (backward compat).
  zone          String?
  // Modelo hardware: "PAX_A920_PRO" | "OTRO" (futuro: REDSYS_VX, INGENICO...).
  hardwareModel String?
  // S/N físico del datáfono — futuro mapping con Paytef Terminal ID.
  deviceSerial  String?
  // App NightPay en el datáfono (Paytef Device API): credencial del aparato
  // (solo el hash) y código de vinculación de un solo uso.
  deviceTokenHash      String?   @unique
  devicePairedAt       DateTime? @db.Timestamptz
  deviceLastSeenAt     DateTime? @db.Timestamptz
  pairingCodeHash      String?   @unique
  pairingCodeExpiresAt DateTime? @db.Timestamptz
  // Rotación de la credencial: la nueva convive con la anterior hasta que el
  // datáfono la usa (si no le llega la respuesta, la anterior sigue valiendo).
  // Fecha de la credencial en uso, para la caducidad opcional
  // (POS_DEVICE_TOKEN_MAX_AGE_DAYS; sin ella, no caduca).
  deviceTokenNextHash  String?   @unique
  deviceTokenIssuedAt  DateTime? @db.Timestamptz

  venue    Venue     @relation(fields: [tenantId], references: [id])
  payments Payment[]
  posOps   PosTerminalOp[]

  @@unique([tenantId, externalId])
  @@index([tenantId])
  @@index([tenantId, zone])
  @@map("terminals")
}

// ───────────────────────── Gateway credentials ─────────────────────

enum Provider {
  WIPAY   // ESP Global Payment Systems — acquirer; sin claves activas
  PEANPE  // pasarela alternativa; sin claves activas
  PAYTEF  // pasarela omnicanal Paytef (Payment LINK API) — único activo hoy
  REDSYS  // Redsys SIS — protocolo estándar de bancos ES (BBVA, Santander,
          // CaixaBank, Sabadell). Form POST hosted + HMAC-SHA256-3DES.
}

model GatewayCredential {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String   @db.Uuid
  provider   Provider
  // Credenciales cifradas AES-256-GCM
  encKey     Bytes
  encNonce   Bytes
  encTag     Bytes
  kekVersion Int
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, provider, active])
  @@map("gateway_credentials")
}

// ───────────────────────── Payments ────────────────────────────────

enum PaymentStatus {
  CREATED
  AWAITING_CAPTURE
  AUTHORIZING
  AUTHORIZED
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
  ORPHAN
  CANCELED
}

// Peanpe mapping table — Peanpe limita identificador_llamada a 6 chars.
// Persistimos el mapping payment.id (UUID) ↔ identificador_llamada (6 chars)
// + el securityToken para validar el challenge-response del webhook.
model PeanpeCall {
  identificadorLlamada String    @id @map("identificador_llamada")
  paymentId            String    @unique @db.Uuid
  tenantId             String    @db.Uuid
  securityToken        String
  amountCents          Int
  resultStatus         String?
  resultMsg            String?
  resultReceivedAt     DateTime? @db.Timestamptz
  createdAt            DateTime  @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  venue   Venue   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("peanpe_calls")
}

model Payment {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String        @db.Uuid
  terminalId           String        @db.Uuid
  // Set por payments.service cuando hay request context con userId.
  // null cuando origen no humano (cron, webhook reconcile, etc.).
  createdByUserId      String?       @db.Uuid
  idempotencyKey       String
  // Huella (sha256) de quién creó el cobro + lo que pidió: la misma
  // Idempotency-Key con otra persona u otra petición → 409. Null = cobro de
  // antes de guardarla (solo se compara quién lo creó).
  idempotencyHash      String?
  amountCents          Int
  currency             String        @default("EUR") @db.Char(3)
  status               PaymentStatus @default(CREATED)
  provider             Provider?
  providerTxId         String?
  qrToken              String        @unique
  qrExpiresAt          DateTime      @db.Timestamptz
  availableAmountCents Int
  createdAt            DateTime      @default(now()) @db.Timestamptz
  updatedAt            DateTime      @updatedAt @db.Timestamptz

  // Modo de cobro usado: "QR" | "WALLET_TOPUP". Null para payments antiguos (asume QR).
  captureMethod String?

  // Categoría contable del cobro: CHICA_SERVICE | VENUE_BAR | VENUE_ROOM | VENUE_FOOD | EXTRA.
  // Determina (a) si genera earning para la chica creator y a qué bps, y
  // (b) cómo se agrega en el Z-report (split chicas vs local).
  // CHICA_SERVICE: usa User.commissionBps (override) o Venue.operatorCommissionDefaults.CHICA_SERVICE
  // VENUE_*     : siempre usa Venue.operatorCommissionDefaults[<categoría>]
  revenueCategory String  @default("EXTRA")

  // Phase 1B — si este Payment es el top-up de un ClientWallet, walletId apunta
  // a la wallet creada/recargada. Cuando Payment llega a AUTHORIZED, el balance
  // de la wallet se suma atómicamente.
  walletId String? @db.Uuid

  // Snapshot del % plataforma al momento del cobro. Si Venue.platformCommissionBps
  // cambia mañana, contabilidad histórica usa este valor congelado.
  platformCommissionBps Int?
  // Snapshot del % de la chica (OPERATOR) al crear el cobro: su commissionBps
  // o el del local para la categoría. Al pagarse se usa este, no el de ese
  // momento. Null = cobro anterior o que no es de una chica (se calcula al pagar).
  operatorCommissionBps Int?

  // Propina opcional (cliente decide añadir). Campos:
  //  - tipCents: importe extra sobre amountCents (no entra en availableAmountCents
  //              base, va a tipBeneficiary).
  //  - tipGoesTo: política — 'operator' (chica creator), 'venue' (local), 'shared',
  //              'beneficiary' (usa tipBeneficiaryUserId explícito).
  //  - tipBeneficiaryUserId: override del beneficiario cuando tipGoesTo='beneficiary'.
  tipCents              Int     @default(0)
  tipGoesTo             String?
  tipBeneficiaryUserId  String? @db.Uuid

  // URL del payment-link/checkout del PSP. NightPay redirige al cliente aquí
  // cuando escanea el QR. Se popula al primer startAuthorization() exitoso.
  gatewayPaymentUrl    String?

  // Para PSPs que esperan form POST desde el navegador (Cecabank/Wipay TPV
  // Virtual, Redsys, etc.) en vez de redirect. Shape:
  //   { action: string, method: "POST", fields: Record<string,string> }
  // Persistido para que un refresh del /pay/{token} no regenere firmas
  // distintas (Cecabank rechaza Num_operacion duplicado).
  gatewayCheckoutForm  Json?

  // Datos de tokenización capturados del callback PSP cuando el cobro pidió
  // crear un token de tarjeta para cobros recurrentes (PIN-flow). Shape:
  //   { identifier: string, expiry: string, cardLast4: string,
  //     cardBrand: string, cofTxnId: string, capturedAt: string (ISO) }
  // El identifier es el token reusable (NO el PAN). NightPay nunca almacena
  // PAN ni CVV — eso lo gestiona el PSP. SAQ-A compliant.
  tokenizationData     Json?

  // Fase 0 — datos que manda el banco al aprobar (aviso Redsys o confirmación
  // de datáfono). payMethodCode = Ds_ProcessedPayMethod tal cual (sin mapear
  // hasta confirmar los códigos de Apple/Google Pay con BBVA).
  payMethodCode String?
  cardBrand     String?
  cardType      String?
  cardCountry   String?
  cardLast4     String?
  authCode      String?
  secure3ds     Boolean?
  authorizedAt  DateTime? @db.Timestamptz

  // Fase 1A — foto del servicio de la carta (si el cobro salió de ella).
  serviceItemId String?   @db.Uuid
  serviceName   String?
  // Datáfono PAX: número de operación de Paytef y datáfono que lo cobró (el
  // par es único: una operación paga un solo cobro).
  posOperationNumber String?
  posTerminalId      String? @db.Uuid
  durationMin   Int?

  venue              Venue            @relation(fields: [tenantId], references: [id])
  terminal           Terminal         @relation(fields: [terminalId], references: [id])
  createdBy          User?            @relation("PaymentCreatedBy", fields: [createdByUserId], references: [id])
  wallet             ClientWallet?    @relation(fields: [walletId], references: [id])
  tipBeneficiary     User?            @relation("PaymentTipBeneficiary", fields: [tipBeneficiaryUserId], references: [id])
  events             PaymentEvent[]
  refunds            Refund[]
  operatorEarning    OperatorEarning?
  peanpeCall         PeanpeCall?
  attempts           PaymentAttempt[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, createdByUserId, createdAt(sort: Desc)])
  @@index([providerTxId])
  @@index([qrExpiresAt])
  @@index([walletId])
  @@index([tipBeneficiaryUserId])
  @@unique([posTerminalId, posOperationNumber])
  @@map("payments")
}

// Fase 0 — un intento = un pedido en la pasarela (Redsys Ds_Order). Un pago
// puede tener varios (reintento con otra tarjeta). No es tenant-scoped en el
// middleware: se accede vía asSystem (cliente sin login, avisos del banco).
model PaymentAttempt {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId    String   @db.Uuid
  tenantId     String   @db.Uuid
  provider     Provider
  providerTxId String
  // PENDING | APPROVED | DENIED
  status       String   @default("PENDING")
  responseCode String?
  // Fase 1B: lo que se mandó al banco en este intento (NULL = antes de 1B).
  amountCents  Int?
  tipCents     Int?
  // wallet (Apple Pay / Google Pay) | card
  payMethod    String?
  // Huella de la cookie del navegador que abrió el intento (enlace del saldo).
  claimHash    String?
  createdAt    DateTime @default(now()) @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerTxId])
  @@index([paymentId, createdAt(sort: Desc)])
  @@map("payment_attempts")
}

// Saldo NightPay — cobro del saldo que el cliente acepta en su móvil.
// tenantId = local donde se cobra (puede ser otro local del mismo grupo).
model WalletChargeRequest {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String    @db.Uuid
  // Null en un cobro con QR hasta que el cliente lo paga con su Face ID.
  walletId          String?   @db.Uuid
  requestedByUserId String    @db.Uuid
  amountCents       Int
  category          String
  serviceName       String?
  // PENDING | ACCEPTED | REJECTED | EXPIRED | CANCELED
  status            String    @default("PENDING")
  expiresAt         DateTime  @db.Timestamptz
  decidedAt         DateTime? @db.Timestamptz
  consumptionId     String?   @db.Uuid
  // Cobro con QR: el token del enlace /s/<payToken> que escanea el cliente.
  payToken          String?   @unique
  createdAt         DateTime  @default(now()) @db.Timestamptz

  wallet ClientWallet? @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId, status])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wallet_charge_requests")
}

// Saldo NightPay — devolución del saldo al cliente que se va.
model WalletPayout {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  walletId      String   @db.Uuid
  amountCents   Int
  // CARD (hecha en el portal de BBVA) | CASH (en efectivo en el local)
  method        String
  bankReference String?
  note          String?
  paidByUserId  String   @db.Uuid
  createdAt     DateTime @default(now()) @db.Timestamptz
  // DONE (hecha) | PENDING (a la tarjeta, apuntándose en el banco: el saldo
  // ya salió de la wallet; se retoma si se quedó a medias). Una PENDING por
  // wallet (índice parcial wallet_payouts_one_pending_per_wallet). Las sumas
  // de lo devuelto, solo con DONE.
  status        String    @default("DONE")
  // Cuándo se empezó a apuntar (un segundo clic no la apunta dos veces).
  claimedAt     DateTime? @db.Timestamptz

  wallet ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("wallet_payouts")
}

// Datáfono PAX — operaciones del cierre de jornada del datáfono, para cuadrar.
model PosTerminalOp {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String    @db.Uuid
  terminalId      String    @db.Uuid
  operationNumber String
  opType          String
  amountCents     Int?
  occurredAt      DateTime? @db.Timestamptz
  reportedAt      DateTime  @default(now()) @db.Timestamptz

  venue    Venue    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  terminal Terminal @relation(fields: [terminalId], references: [id], onDelete: Cascade)

  @@unique([terminalId, operationNumber])
  @@map("pos_terminal_ops")
}

// Fase 1E — incidencias que el dueño ya revisó (las incidencias se calculan al vuelo).
model IncidentAck {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId String   @db.Uuid
  kind     String
  refId    String
  ackedBy  String?  @db.Uuid
  note     String?
  ackedAt  DateTime @default(now()) @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, kind, refId])
  @@map("incident_acks")
}

// Fase 1D — noche del local: se abre y se cierra con informe Z congelado.
// Una sola abierta por local (índice parcial en SQL: venue_nights_one_open_per_venue).
model VenueNight {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  openedAt       DateTime  @default(now()) @db.Timestamptz
  openedBy       String?   @db.Uuid
  closedAt       DateTime? @db.Timestamptz
  closedBy       String?   @db.Uuid
  autoClosed     Boolean   @default(false)
  pendingAtClose Int       @default(0)
  closeNote      String?
  zReport        Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, openedAt(sort: Desc)])
  @@map("venue_nights")
}

// Fase 1A — carta de servicios por local. La chica elige un servicio en vez
// de teclear importe; precio y categoría los fija el local.
model ServiceItem {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  durationMin Int?
  priceCents  Int
  // CHICA_SERVICE | VENUE_BAR | VENUE_ROOM | VENUE_FOOD | EXTRA
  category    String   @default("CHICA_SERVICE")
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz

  venue Venue @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active, sortOrder])
  @@map("service_items")
}

model PaymentEvent {
  id         BigInt   @id @default(autoincrement())
  paymentId  String   @db.Uuid
  tenantId   String   @db.Uuid
  eventType  String
  payload    Json
  traceId    String
  occurredAt DateTime @default(now()) @db.Timestamptz

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([traceId])
  @@map("payment_events")
}

// ───────────────────────── Refunds ─────────────────────────────────

enum RefundStatus {
  PENDING
  SUCCEEDED
  FAILED
}

model Refund {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String       @db.Uuid
  paymentId        String       @db.Uuid
  amountCents      Int
  reason           String?
  requestedBy      String       @db.Uuid
  status           RefundStatus @default(PENDING)
  providerRefundId String?
  // Fase 1C: hecha en el portal del banco y apuntada a mano en el panel.
  registeredManually Boolean     @default(false)
  bankRefundedAt     DateTime?   @db.Timestamptz
  createdAt        DateTime     @default(now()) @db.Timestamptz

  payment   Payment           @relation(fields: [paymentId], references: [id])
  reversals EarningReversal[]

  @@index([tenantId, paymentId])
  @@map("refunds")
}

// ───────────────────────── Operator earnings & payouts ─────────────
// Una fila por payment AUTHORIZED creado por una operadora (chica).
// Snapshot de comisión al momento de autorizar — cambios posteriores de
// commissionBps en User no afectan earnings ya creados.

model OperatorEarning {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  operatorId         String   @db.Uuid
  // Source: exactly ONE of paymentId or consumptionId must be set.
  // (DB CHECK constraint en migración + ambos @unique para evitar doble-pago).
  paymentId          String?  @unique @db.Uuid
  // Phase 1B — earnings generadas por consumo de wallet ("tiempo" con chica
  // en operator app). Mismo ledger que paymentId, distinto origen.
  consumptionId      String?  @unique @db.Uuid
  paymentAmountCents Int
  commissionBps      Int
  // Calculado: round(paymentAmountCents * commissionBps / 10000) — banker-like
  // rounding para evitar bias unidireccional contra operadora.
  commissionCents    Int
  // Propinas asociadas al earning (cliente añadió tip dirigido a esta chica).
  // 100% del tip va a la operadora; no se reduce con BPS.
  tipCents           Int      @default(0)
  // Suma acumulada de descuentos por refunds proporcionales.
  // Saldo neto del earning = commissionCents + tipCents - reversedCents.
  reversedCents      Int      @default(0)
  // Null = pendiente de payout. Set cuando admin marca pagado.
  payoutId           String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz

  venue       Venue              @relation(fields: [tenantId], references: [id])
  operator    User               @relation("OperatorEarnings", fields: [operatorId], references: [id])
  payment     Payment?           @relation(fields: [paymentId], references: [id])
  consumption WalletConsumption? @relation(fields: [consumptionId], references: [id])
  payout      OperatorPayout?    @relation("EarningPayout", fields: [payoutId], references: [id])
  reversals   EarningReversal[]

  @@index([tenantId, operatorId, payoutId])
  @@index([tenantId, operatorId, createdAt(sort: Desc)])
  @@map("operator_earnings")
}

// Idempotency log para refund → earning reversal.
// Cada refund SUCCEEDED dispara una sola fila aquí (refundId UNIQUE).
// Reintento del processor no duplica el descuento.
model EarningReversal {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String   @db.Uuid
  earningId          String   @db.Uuid
  // Origen de la deuda: una devolución del banco o un consumo del saldo anulado.
  refundId           String?  @unique @db.Uuid
  consumptionId      String?  @unique @db.Uuid
  reversedDeltaCents Int
  // true = el earning ya estaba pagado: el descuento es deuda de la chica y
  // se resta del siguiente payout (settledPayoutId = ese payout).
  afterPayout        Boolean  @default(false)
  settledPayoutId    String?  @db.Uuid
  createdAt          DateTime @default(now()) @db.Timestamptz

  earning OperatorEarning @relation(fields: [earningId], references: [id], onDelete: Cascade)
  refund  Refund?         @relation(fields: [refundId], references: [id], onDelete: Cascade)

  @@index([earningId])
  @@index([tenantId, createdAt(sort: Desc)])
  @@map("earning_reversals")
}

// Una fila por liquidación admin → operadora.
// totalCents = SUM(commissionCents - reversedCents) de earnings agrupadas.

model OperatorPayout {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  operatorId   String   @db.Uuid
  totalCents   Int
  paidByUserId String   @db.Uuid
  notes        String?
  createdAt    DateTime @default(now()) @db.Timestamptz

  // Phase 1A — referencia externa + estado reconciliación
  externalTxId         String?
  externalRail         String?
  reconciliationStatus String   @default("UNRECONCILED")
  receiptUrl           String?
  reconciledAt         DateTime? @db.Timestamptz
  reconciledByUserId   String?  @db.Uuid

  // FX snapshot al momento de crear el payout (para rails cripto). Permite
  // reconciliar con la tasa congelada, no la actual — evita falsos MISMATCH
  // por volatilidad EUR↔USDT entre creación y verificación on-chain.
  expectedAmountUsdt   Decimal? @db.Decimal(20, 6)
  payoutFxRate         Decimal? @db.Decimal(12, 6)

  venue        Venue             @relation(fields: [tenantId], references: [id])
  operator     User              @relation("OperatorPayouts", fields: [operatorId], references: [id])
  paidBy       User              @relation("PayoutsPaid", fields: [paidByUserId], references: [id])
  reconciledBy User?             @relation("PayoutsReconciled", fields: [reconciledByUserId], references: [id])
  earnings     OperatorEarning[] @relation("EarningPayout")

  @@index([tenantId, operatorId, createdAt(sort: Desc)])
  @@index([tenantId, reconciliationStatus])
  @@map("operator_payouts")
}

// ───────────────────────── Webhooks ────────────────────────────────

model WebhookDelivery {
  id              BigInt    @id @default(autoincrement())
  provider        Provider
  externalEventId String
  rawBody         Bytes
  signature       String
  processedAt     DateTime? @db.Timestamptz
  tenantId        String?   @db.Uuid
  createdAt       DateTime  @default(now()) @db.Timestamptz

  @@unique([provider, externalEventId])
  @@index([processedAt])
  @@map("webhook_deliveries")
}

// ───────────────────────── Reconciliation ──────────────────────────

enum ReconStatus {
  OK
  MISMATCH
  PARTIAL
}

model Reconciliation {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String      @db.Uuid
  provider          Provider
  day               DateTime    @db.Date
  localTotalCents   Int
  gatewayTotalCents Int
  diffCents         Int
  status            ReconStatus
  discrepancies     Json?
  runAt             DateTime    @default(now()) @db.Timestamptz

  @@unique([tenantId, provider, day])
  @@index([status])
  @@map("reconciliations")
}

// ───────────────────────── Audit log ────────────────────────────────
// Append-only, no DELETE/UPDATE. Forense de cambios sensibles:
// - login (success/failure)
// - refund (cualquier importe)
// - cambios de role / credenciales / passwords
// - revocacion de JWT
// tenantId puede ser null para acciones globales del owner cross-venue.

model AuditEvent {
  id          BigInt    @id @default(autoincrement())
  tenantId    String?   @db.Uuid
  actorId     String?   @db.Uuid
  actorEmail  String?
  action      String
  targetType  String?
  targetId    String?
  payload     Json?
  ip          String?
  userAgent   String?
  traceId     String?
  occurredAt  DateTime  @default(now()) @db.Timestamptz

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([actorId, occurredAt(sort: Desc)])
  @@index([action, occurredAt(sort: Desc)])
  @@index([traceId])
  @@map("audit_events")
}

// ───────────────────────── Phase 1B — Client Wallet ─────────────────
// Closed-loop prepaid wallet (cash-in-advance). Legal vía EMD2 art. 1.5(k):
// el saldo solo se gasta dentro del venue emisor, sin convertirse en cash
// directamente. El cliente carga UNA VEZ (un cargo en su tarjeta con
// descriptor neutro), consume durante la noche en barra/habitaciones/chicas,
// y el saldo no consumido se reembolsa al cierre.

enum WalletStatus {
  ACTIVE
  EXPIRED
  REFUNDED
  DEPLETED
}

model ClientWallet {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String       @db.Uuid
  // Identificador opcional del cliente (phone, email, NFC tag, anon hash).
  // No es PII obligatoria — el saldo se identifica por qrToken.
  identifier   String?
  balanceCents Int          @default(0)
  status       WalletStatus @default(ACTIVE)
  // Null = no expira mientras ACTIVE (típico durante la noche).
  // Set cuando admin convierte balance restante en CRÉDITO para próxima visita.
  expiresAt    DateTime?    @db.Timestamptz
  // Token único en el QR del cliente. La operadora/camarero/recepción escanean
  // este token para cobrar consumiciones.
  qrToken      String       @unique
  // Saldo NightPay: código que enseña el cliente, grupo de locales y si pidió
  // que le devuelvan el saldo.
  shortCode        String?
  walletGroup      String?
  closeRequestedAt DateTime? @db.Timestamptz
  // Recarga sumada a otro saldo del mismo cliente (con su Face ID).
  mergedIntoId     String?   @db.Uuid
  // PIN del cliente para pagar sin sacar el móvil (HMAC del servidor + scrypt).
  pinHash          String?
  // 5 PIN fallidos seguidos → bloqueado hasta que lo desbloquee el encargado.
  pinFails         Int       @default(0)
  pinLockedAt      DateTime? @db.Timestamptz
  pinFailedAt      DateTime? @db.Timestamptz
  // El encargado que puso el PIN sin el cliente delante: él no cobra con ese PIN.
  pinSetById       String?   @db.Uuid
  createdAt    DateTime     @default(now()) @db.Timestamptz
  updatedAt    DateTime     @updatedAt @db.Timestamptz

  venue          Venue                 @relation(fields: [tenantId], references: [id])
  topUps         Payment[]
  consumptions   WalletConsumption[]
  chargeRequests WalletChargeRequest[]
  payouts        WalletPayout[]
  passkeys       WalletPasskey[]
  cards          WalletCard[]

  @@index([tenantId, status])
  @@index([tenantId, identifier])
  @@index([tenantId, createdAt(sort: Desc)])
  @@index([mergedIntoId])
  @@map("client_wallets")
}

/// Ficha NFC del saldo: lleva grabado un enlace con `token` (?ficha=...).
/// Dice de qué saldo es; para pagar, el cliente pone su PIN.
/// Sin tenantId ni RLS a propósito: se graba en blanco y se da a un saldo de
/// cualquier local del grupo. El acceso va siempre por el saldo (la API
/// comprueba sameWalletGroup con el local de quien la usa; WalletChargesService).
model WalletCard {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  token      String    @unique
  /// Número de serie (si se leyó con un Android): una copia no vale.
  uid        String?
  walletId   String?   @db.Uuid
  /// ACTIVE | BLOCKED (perdida).
  status     String    @default("ACTIVE")
  linkedById String?   @db.Uuid
  createdAt  DateTime  @default(now()) @db.Timestamptz
  linkedAt   DateTime? @db.Timestamptz
  blockedAt  DateTime? @db.Timestamptz
  lastUsedAt DateTime? @db.Timestamptz

  wallet ClientWallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  @@index([walletId])
  @@map("wallet_cards")
}

/// Llave del cliente para pagar con su saldo desbloqueando su móvil (Face ID,
/// huella o el PIN del teléfono). Solo la clave pública.
model WalletPasskey {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId     String    @db.Uuid
  credentialId String    @unique
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   String[]  @default([])
  createdAt    DateTime  @default(now()) @db.Timestamptz
  lastUsedAt   DateTime? @db.Timestamptz

  wallet ClientWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([walletId])
  @@map("wallet_passkeys")
}

// Cada consumo del balance de una wallet. Atómicamente:
//  1. balance -= amountCents (SELECT FOR UPDATE de ClientWallet)
//  2. crea WalletConsumption
//  3. si providedByUser.role = OPERATOR, crea OperatorEarning ligado
// Rollback: si admin cancela un consumo, sumamos reversedAt y devolvemos
// el importe al balance.

model WalletConsumption {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  walletId         String   @db.Uuid
  amountCents      Int
  providedByUserId String   @db.Uuid
  // Categoría libre: "bar" | "room" | "time" | "service" | "other"
  // No es enum porque el venue puede tener categorías propias.
  category         String
  notes            String?
  // Idempotency key para evitar doble-cobro (camarero pulsa 2 veces).
  idempotencyKey   String?
  // Propina opcional dentro del consumo. 100% va a providedBy si es OPERATOR
  // (o según tipGoesTo si se especifica).
  tipCents         Int       @default(0)
  tipGoesTo        String?
  reversedAt       DateTime? @db.Timestamptz
  reversedByUserId String?   @db.Uuid
  createdAt        DateTime  @default(now()) @db.Timestamptz

  venue       Venue            @relation(fields: [tenantId], references: [id])
  wallet      ClientWallet     @relation(fields: [walletId], references: [id])
  providedBy  User             @relation("ConsumptionProvider", fields: [providedByUserId], references: [id])
  reversedBy  User?            @relation("ConsumptionReversedBy", fields: [reversedByUserId], references: [id])
  earning     OperatorEarning?

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, walletId, createdAt(sort: Desc)])
  @@index([tenantId, providedByUserId, createdAt(sort: Desc)])
  @@index([tenantId, category])
  @@map("wallet_consumptions")
}

// ─── Cuadre con el banco (2026-10-14) ────────────────────────────────────
// Fichero de operaciones del portal de BBVA/Redsys o de Paytef comparado
// línea a línea con lo apuntado. tenantId = local desde el que se sube.
model BankStatement {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String    @db.Uuid
  // REDSYS | PAYTEF
  source           String
  fileName         String
  fileSha256       String
  periodFrom       DateTime  @db.Date
  periodTo         DateTime  @db.Date
  rowsTotal        Int
  skippedCount     Int       @default(0)
  otherCount       Int       @default(0)
  matchedCount     Int
  problemCount     Int
  bankTotalCents   Int
  oursTotalCents   Int
  uploadedByUserId String    @db.Uuid
  supersededAt     DateTime? @db.Timestamptz
  createdAt        DateTime  @default(now()) @db.Timestamptz

  items BankStatementItem[]

  @@index([tenantId, createdAt(sort: Desc)])
  @@map("bank_statements")
}

// Una línea del cuadre. tenantId = local al que se atribuye.
model BankStatementItem {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  statementId     String    @db.Uuid
  tenantId        String    @db.Uuid
  status          String
  // SALE | REFUND
  kind            String
  line            Int?
  occurredAt      DateTime? @db.Timestamptz
  bankAmountCents Int?
  oursAmountCents Int?
  reference       String?
  terminal        String?
  authCode        String?
  paymentId       String?   @db.Uuid
  refundId        String?   @db.Uuid
  supersededAt    DateTime? @db.Timestamptz
  createdAt       DateTime  @default(now()) @db.Timestamptz

  statement BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([tenantId, status])
  @@map("bank_statement_items")
}
