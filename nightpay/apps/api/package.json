{
  "name": "@nightpay/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e ../../.env.local -- tsx watch src/main.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0 || true",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-fastify": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@fastify/jwt": "^8.0.1",
    "@nightpay/contracts": "workspace:*",
    "@nightpay/db": "workspace:*",
    "bcryptjs": "^2.4.3",
    "fastify": "^4.28.0",
    "nestjs-cls": "^4.4.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@nightpay/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.2",
    "dotenv-cli": "^7.4.2",
    "supertest": "^7.0.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0",
    "tsx": "^4.19.0"
  }
}
