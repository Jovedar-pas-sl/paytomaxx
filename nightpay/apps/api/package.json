{
  "name": "@nightpay/api",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "pnpm --filter @nightpay/db heal && tsx watch src/dev.ts",
    "dev:noheal": "tsx watch src/dev.ts",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "partner:docs": "tsx scripts/partner-openapi.ts",
    "partner:demo-seed": "tsx scripts/partner-demo-seed.ts",
    "test:watch": "vitest",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0 || true",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1150.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.1",
    "@nestjs/bullmq": "^11.0.5",
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-fastify": "^11.2.7",
    "@nestjs/platform-socket.io": "^11.2.7",
    "@nestjs/websockets": "^11.2.7",
    "@nightpay/contracts": "workspace:*",
    "@nightpay/db": "workspace:*",
    "@sentry/node": "^10.77.1",
    "@simplewebauthn/server": "14.0.3",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.13.0",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.7",
    "ioredis": "^5.4.1",
    "nestjs-cls": "^5.4.3",
    "opossum": "^8.4.0",
    "pg": "^8.23.1",
    "pino": "^9.3.0",
    "pino-pretty": "^11.2.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "redsys-easy": "^5.3.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.0",
    "socket.io-adapter": "^2.5.5",
    "speakeasy": "^2.0.0",
    "web-push": "3.6.7",
    "xstate": "^5.18.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@nightpay/config": "workspace:*",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.0",
    "@types/opossum": "^8.1.8",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/speakeasy": "^2.0.10",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "3.6.4",
    "@vitest/coverage-v8": "2.1.9",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.0"
  }
}
