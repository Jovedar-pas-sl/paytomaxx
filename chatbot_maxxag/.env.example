# ══════════════════════════════════════════════════════════════════
# Maxxag WA Ops — example env file (PLACEHOLDERS ONLY — never commit real values)
#
# Copy to `.env` and fill every value below. The KPI app reads these via
# app/settings.py. The repo's pre-commit secret-guard (.pre-commit-config.yaml)
# blocks real Anthropic keys from being committed; keep this file fake.
#
# This file was recreated after a history purge (finding M9). Rotating any live
# key and purging git history are the owner's manual actions.
# ══════════════════════════════════════════════════════════════════

# ── Databases ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://kpi:CHANGE_ME@postgres:5432/kpi
REDIS_URL=redis://redis:6379/0

# ── Anthropic (Claude Haiku 4.5 for conversation analysis) ────────
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
# Optional overrides — defaults live in app/settings.py
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_PRICE_INPUT_PER_MTOK=0.80
# CLAUDE_PRICE_OUTPUT_PER_MTOK=4.0

# ── KPI app auth ──────────────────────────────────────────────────
# JWT secret — generate: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
# Session lifetime in hours (default 12). Keep short — no server-side revocation.
# JWT_EXPIRES_HOURS=12
KPI_ADMIN_EMAIL=admin@example.com
# bcrypt hash — never plaintext. Generate: python scripts/hash-admin-password.py
KPI_ADMIN_PASSWORD_HASH=CHANGE_ME

# ── WAHA (WhatsApp bridge) ────────────────────────────────────────
WAHA_API_URL=http://waha:3000
WAHA_API_KEY=CHANGE_ME
# Shared secret for the WAHA → KPI webhook HMAC. REQUIRED in production:
# the app refuses to start with an empty secret unless DEBUG=true.
# Generate: openssl rand -hex 32
WAHA_WEBHOOK_HMAC=CHANGE_ME

# ── Runtime ───────────────────────────────────────────────────────
# Role — "web" or "worker" (normally set by docker-compose)
ROLE=web
# Debug/dev mode. MUST be false in production (gates the empty-HMAC allowance).
DEBUG=false
# Cookie security: true in production (HTTPS), false for local HTTP demo.
COOKIE_SECURE=true
# Public domain used for links from the KPI app (optional).
DOMAIN=

# ── Login rate limit ──────────────────────────────────────────────
LOGIN_RATE_MAX_FAILS=10
LOGIN_RATE_WINDOW_SECONDS=300
