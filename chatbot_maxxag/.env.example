# Copia este archivo como .env y rellena los valores

# Claude API Key (para respuestas libres con IA)
# Consíguelo en: https://console.anthropic.com
ANTHROPIC_API_KEY=***REMOVED***

# Token secreto para el panel admin
# Cambia esto por algo seguro y guárdalo
ADMIN_TOKEN=***REMOVED****

# Puerto del servidor (por defecto 5050)
PORT=5050

# Debug (1 = activado, 0 = producción)
FLASK_DEBUG=1
