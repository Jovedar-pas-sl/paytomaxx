# ── KPI dashboard (inbox + métricas + análisis IA) ────────────────
{$DOMAIN}, kpi.{$DOMAIN} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
    }

    reverse_proxy kpi-app:5000 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }
}

# ── WAHA dashboard + API ──────────────────────────────────────────
# Dashboard: https://wa.DOMAIN/dashboard  (basic auth via WAHA env)
# API:       https://wa.DOMAIN/api/...    (X-Api-Key header)
wa.{$DOMAIN} {
    encode gzip zstd
    reverse_proxy waha:3000 {
        header_up X-Forwarded-Proto https
        header_up X-Real-IP {remote_host}
    }
}

# ── Legacy admin subdomain → redirect to apex (Chatwoot removed) ─
admin.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}
