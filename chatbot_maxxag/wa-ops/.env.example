# ══════════════════════════════════════════════════════════════════
# Maxxag WA Ops — example env file
# Copy to `.env` and fill. Use `scripts/install-vps.sh` to auto-generate secrets.
# ══════════════════════════════════════════════════════════════════

# ── Domain + HTTPS ────────────────────────────────────────────────
DOMAIN=<YOUR_DOMAIN>                              # e.g. maxxagops.com — set when decided
CADDY_EMAIL=admin@nouesmalt.com

# ── Postgres (single cluster, 3 DBs) ──────────────────────────────
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=<GENERATE_WITH_openssl_rand_hex_24>
CHATWOOT_DB_PASSWORD=<GENERATE_WITH_openssl_rand_hex_24>
EVOLUTION_DB_PASSWORD=<GENERATE_WITH_openssl_rand_hex_24>
KPI_DB_PASSWORD=<GENERATE_WITH_openssl_rand_hex_24>

# ── Evolution API ─────────────────────────────────────────────────
# Generate: openssl rand -hex 32
EVOLUTION_API_KEY=<GENERATE_WITH_openssl_rand_hex_32>

# ── Anthropic (Claude Haiku 4.5 for conversation analysis) ────────
ANTHROPIC_API_KEY=sk-ant-<YOUR_KEY>

# ── KPI app auth ──────────────────────────────────────────────────
# JWT secret — generate: openssl rand -hex 32
JWT_SECRET=<GENERATE_WITH_openssl_rand_hex_32>

# Admin login (email + bcrypt hash — never plaintext)
# Generate hash: python scripts/hash-admin-password.py
KPI_ADMIN_EMAIL=sales@nouesmalt.com
KPI_ADMIN_PASSWORD_HASH=<GENERATE_WITH_scripts/hash-admin-password.py>
