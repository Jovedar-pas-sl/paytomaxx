# ══════════════════════════════════════════════════════════════════
# Maxxag WA Ops — PRODUCTION env TEMPLATE
# Copy to `.env` on the server and fill every REPLACE_ME with a real
# secret. NEVER commit the filled-in .env (it is gitignored).
# ══════════════════════════════════════════════════════════════════

DOMAIN=your-domain.example
CADDY_EMAIL=admin@your-domain.example

# Postgres
POSTGRES_PASSWORD=REPLACE_ME
KPI_DB_PASSWORD=REPLACE_ME

# WAHA (WhatsApp bridge — replaces Evolution)
WAHA_API_KEY=REPLACE_ME
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=REPLACE_ME
# HMAC shared secret: WAHA signs webhook body, KPI verifies. Empty = disabled (dev only).
WAHA_WEBHOOK_HMAC=

# Claude (production API key from console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# KPI auth
JWT_SECRET=REPLACE_ME
KPI_ADMIN_EMAIL=admin@your-domain.example
# bcrypt hash of the admin password (e.g. `python -c "import bcrypt,sys;print(bcrypt.hashpw(sys.argv[1].encode(),bcrypt.gensalt()).decode())" 'yourpass'`)
KPI_ADMIN_PASSWORD_HASH=REPLACE_ME

# Cookie (TRUE in production — HTTPS via Caddy)
COOKIE_SECURE=true
