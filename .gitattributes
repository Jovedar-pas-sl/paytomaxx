# Auto detect text files and perform LF normalization
* text=auto

# Se ejecutan dentro de contenedores Linux: siempre LF, también en Windows
# (un CRLF rompe el shebang y los RUN/CMD).
*.sh text eol=lf
Dockerfile text eol=lf

# Scripts de Windows: siempre CRLF.
*.bat text eol=crlf

# Marcas oficiales de la portada (Apple Pay, Google Pay…): byte a byte como
# las publica cada marca (su sha256 se comprueba en portada-puertas.spec.ts).
nightpay/apps/web-client/public/portada/marcas/*.svg -text
